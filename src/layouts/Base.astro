---
import '@fontsource-variable/public-sans';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../config/site';
import { paths, htmlLang, ogLocale, type Lang, type PageKey } from '../i18n/routes';
import { t } from '../i18n';

interface Props { lang: Lang; page: PageKey }
const { lang, page } = Astro.props;
const c = t(lang);
const meta = c.meta[page];
const title = page === 'home' ? `${meta.title} | ${site.shortName}` : `${meta.title} | ${site.shortName}`;
const other: Lang = lang === 'es' ? 'en' : 'es';
const abs = (p: string) => new URL(p, site.url).toString();
const canonical = abs(paths[page][lang]);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  email: site.email,
  telephone: site.phone,
};
---
<!doctype html>
<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={meta.description} />
    <meta name="theme-color" content="#020617" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={htmlLang[lang]} href={canonical} />
    <link rel="alternate" hreflang={htmlLang[other]} href={abs(paths[page][other])} />
    <link rel="alternate" hreflang="x-default" href={abs(paths[page].es)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[lang]} />
    <meta property="og:locale:alternate" content={ogLocale[other]} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:bg-amber-400 focus:px-4 focus:py-2 focus:font-semibold focus:text-slate-950"
    >{c.common.skip}</a>
    <Header lang={lang} page={page} />
    <main id="contenido">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
