---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Experiencia y Casos de Éxito | Serviproma Energy">
  <!-- Hero Experiencia -->
  <section class="py-20 border-b border-slate-800 bg-slate-900/30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-4xl">
      <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block mb-2">Track Record Técnico</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">Experiencia Comprobada en Campo</h1>
      <p class="mt-4 text-slate-400 text-base leading-relaxed">
        Más de tres décadas de experiencia combinada ejecutando proyectos de protecciones, pruebas y automatización para las principales empresas de energía del continente.
      </p>
    </div>
  </section>

  <!-- Proyectos Destacados por Región -->
  <section class="py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      
      <!-- Experiencia en Venezuela -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="text-2xl">🇻🇪</span>
          <h2 class="text-2xl font-bold text-white">Venezuela · Sector Eléctrico e Industria</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
            <div class="text-xs font-bold text-amber-400 mb-1">2024 · Petroquímica</div>
            <h3 class="text-lg font-bold text-white mb-2">PEQUIVEN – Metanol de Oriente</h3>
            <p class="text-xs text-slate-400 leading-relaxed mb-4">
              Configuración, comisionamiento y puesta en servicio integral del sistema de control para las subestaciones de Planta 1 y Planta 2.
            </p>
            <span class="text-[11px] px-2.5 py-1 rounded bg-slate-800 text-slate-300">Puesta en servicio · Control</span>
          </div>

          <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
            <div class="text-xs font-bold text-amber-400 mb-1">Sector Eléctrico Nacional</div>
            <h3 class="text-lg font-bold text-white mb-2">CORPOELEC · Transmisión y Despacho</h3>
            <p class="text-xs text-slate-400 leading-relaxed mb-4">
              Ingeniería de campo y automatización en subestaciones de 115 kV a 765 kV en la región Los Andes y Occidente (Trujillo, Táchira, Mérida, Barinas y Alto Apure).
            </p>
            <span class="text-[11px] px-2.5 py-1 rounded bg-slate-800 text-slate-300">Alta y Extra Alta Tensión · SCADA</span>
          </div>
        </div>
      </div>

      <!-- Experiencia en Chile -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="text-2xl">🇨🇱</span>
          <h2 class="text-2xl font-bold text-white">Chile · Transmisión, Generación y Minería</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
            <div class="text-xs font-bold text-amber-400 mb-1">Elecnor · Transmisión</div>
            <h3 class="text-base font-bold text-white mb-2">S/E Cumbres 500 kV (ATR 750 MVA)</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Pruebas FAT y SAT, configuración avanzada del sistema de control y verificación de esquemas en 500 kV.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
            <div class="text-xs font-bold text-amber-400 mb-1">Transelec · Transmisión</div>
            <h3 class="text-base font-bold text-white mb-2">S/E Kimal y Los Changos 220 kV</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Comisionamiento y puesta en servicio de sistemas de protección y control de bahías de línea y transformación.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
            <div class="text-xs font-bold text-amber-400 mb-1">Enfragen / Enel · Generación</div>
            <h3 class="text-base font-bold text-white mb-2">Contratos Marco (14 Centrales)</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Mantenimiento especializado, análisis y respuesta ante fallas y capacitación técnica en 9 centrales de Enfragen y 5 térmicas de Enel.
            </p>
          </div>
        </div>
      </div>

      <!-- Experiencia en Colombia y México -->
      <div>
        <div class="flex items-center gap-3 mb-6">
          <span class="text-2xl">🌎</span>
          <h2 class="text-2xl font-bold text-white">Otros Proyectos Internacionales</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
            <div class="text-xs font-bold text-amber-400 mb-1">Colombia · 230 kV</div>
            <h3 class="text-base font-bold text-white mb-2">S/E Juana La Avanzadora</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Servicios especializados de ingeniería, pruebas de protecciones y puesta en servicio en subestación de interconexión regional.
            </p>
          </div>

          <div class="p-6 rounded-2xl bg-slate-900/60 border border-slate-800">
            <div class="text-xs font-bold text-amber-400 mb-1">México y África</div>
            <h3 class="text-base font-bold text-white mb-2">Proyectos Industriales y Térmicos</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              Intervenciones de ingeniería y parametrización en complejos industriales y subestaciones de distribución en Costa de Marfil y Camerún.
            </p>
          </div>
        </div>
      </div>

    </div>
  </section>
</Layout>
