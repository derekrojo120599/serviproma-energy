---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { paths, type Lang } from '../i18n/routes';
import { t } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const a = c.about;
---
<Base lang={lang} page="about">
  <PageHeader title={a.title} lead={a.lead} />

  <section class="section">
    <div class="wrap grid gap-10 md:grid-cols-[1fr_1.5fr] md:gap-16">
      <h2 class="text-2xl sm:text-3xl">{a.philosophyTitle}</h2>
      <div>
        {a.philosophy.map((p) => <p class="measure mb-5 text-lg text-slate-200">{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section border-y border-slate-800 bg-slate-900">
    <div class="wrap">
      <h2 class="text-2xl sm:text-3xl">{a.methodTitle}</h2>
      <ol class="mt-12 grid gap-10 md:grid-cols-4 md:gap-8">
        {a.steps.map((s, i) => (
          <li class="border-t-2 border-amber-400 pt-5">
            <p class="data m-0 text-sm text-amber-400">{i + 1}</p>
            <h3 class="mt-2 text-xl">{s.title}</h3>
            <p class="mt-3 text-slate-300">{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap grid gap-10 md:grid-cols-[1fr_1.5fr] md:gap-16">
      <h2 class="text-2xl sm:text-3xl">{a.presenceTitle}</h2>
      <p class="measure m-0 text-lg text-slate-200">{a.presence}</p>
    </div>
  </section>

  <CtaBand title={c.home.close.ctaTitle} text={c.home.close.ctaText} button={c.home.close.ctaButton} href={paths.contact[lang]} />
</Base>
