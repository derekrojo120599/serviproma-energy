---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'en';
  currentPath?: string;
  ogImage?: string;
}

const { 
  lang = 'es',
  currentPath = '/',
  ogImage = '/images/og-serviproma.jpg',
  title = lang === 'es' 
    ? "Serviproma Energy | Precisión Técnica en Sistemas de Potencia" 
    : "Serviproma Energy | Precision Engineering in Power Systems", 
  description = lang === 'es'
    ? "Ingeniería, protecciones eléctricas, automatización y sistemas SCADA hasta 765 kV para el sector eléctrico, petrolero e industrial."
    : "Protection, automation, control, and SCADA engineering up to 765 kV for the power, oil, and industrial sectors."
} = Astro.props;

const siteUrl = 'https://servipromaenergy.com';
const routePairs: Record<string, { es: string; en: string }> = {
  '/': { es: '/', en: '/en' },
  '/en': { es: '/', en: '/en' },
  '/nosotros': { es: '/nosotros', en: '/en/about' },
  '/en/about': { es: '/nosotros', en: '/en/about' },
  '/servicios': { es: '/servicios', en: '/en/services' },
  '/en/services': { es: '/servicios', en: '/en/services' },
  '/slrp': { es: '/slrp', en: '/en/slrp' },
  '/en/slrp': { es: '/slrp', en: '/en/slrp' },
  '/experiencia': { es: '/experiencia', en: '/en/experience' },
  '/en/experience': { es: '/experiencia', en: '/en/experience' },
  '/contacto': { es: '/contacto', en: '/en/contact' },
  '/en/contact': { es: '/contacto', en: '/en/contact' },
};

const pair = routePairs[currentPath] || { es: '/', en: '/en' };
const canonicalPath = lang === 'es' ? pair.es : pair.en;
const canonicalUrl = `${siteUrl}${canonicalPath === '/' ? '' : canonicalPath}`;
const esUrl = `${siteUrl}${pair.es === '/' ? '' : pair.es}`;
const enUrl = `${siteUrl}${pair.en}`;
const ogImageUrl = `${siteUrl}${ogImage}`;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Serviproma Energy C.A.',
  url: siteUrl,
  logo: `${siteUrl}/images/logo_blanco.png`,
  image: ogImageUrl,
  description,
  taxID: 'J-508883055',
  telephone: '+58-412-725-1017',
  email: 'admin@servipromaenergy.com',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Av. Las Mercedes, Edif. EXPO 3A, Of. 1-A',
    addressLocality: 'Caracas',
    addressCountry: 'VE',
  },
  areaServed: ['VE', 'CL', 'CO', 'EC', 'PE', 'AO'],
};

const nav = {
  es: [
    { href: '/', label: 'Inicio' },
    { href: '/nosotros', label: 'Empresa' },
    { href: '/servicios', label: 'Servicios' },
    { href: '/slrp', label: 'SLRP', badge: 'Exclusivo' },
    { href: '/experiencia', label: 'Experiencia' },
    { href: '/contacto', label: 'Contacto' },
  ],
  en: [
    { href: '/en', label: 'Home' },
    { href: '/en/about', label: 'Company' },
    { href: '/en/services', label: 'Services' },
    { href: '/en/slrp', label: 'SLRP', badge: 'Exclusive' },
    { href: '/en/experience', label: 'Experience' },
    { href: '/en/contact', label: 'Contact' },
  ],
};

const ctaLabel = lang === 'es' ? 'Cotizar Servicio' : 'Request Assessment';
const ctaHref = lang === 'es' ? '/contacto' : '/en/contact';

const targetLang = lang === 'es' ? 'en' : 'es';
const targetHref = lang === 'es' ? (
  currentPath === '/nosotros' ? '/en/about' :
  currentPath === '/servicios' ? '/en/services' :
  currentPath === '/slrp' ? '/en/slrp' :
  currentPath === '/experiencia' ? '/en/experience' :
  currentPath === '/contacto' ? '/en/contact' : '/en'
) : (
  currentPath === '/en/about' ? '/nosotros' :
  currentPath === '/en/services' ? '/servicios' :
  currentPath === '/en/slrp' ? '/slrp' :
  currentPath === '/en/experience' ? '/experiencia' :
  currentPath === '/en/contact' ? '/contacto' : '/'
);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="192x192" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#133A5A" />

    <!-- Canonical & Hreflang Bilingüe -->
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="es" href={esUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={esUrl} />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Serviproma Energy C.A." />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={lang === 'es' ? 'es_VE' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'es' ? 'en_US' : 'es_VE'} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Datos Estructurados (Schema.org) -->
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body class="bg-[#1C1F23] text-white font-sans selection:bg-[#F2A900] selection:text-[#1C1F23] antialiased flex flex-col min-h-screen">
    <!-- Skip to content link (Accesibilidad) -->
    <a 
      href="#main-content" 
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-[100] focus:px-4 focus:py-2 focus:rounded-md focus:bg-[#F2A900] focus:text-[#1C1F23] focus:font-bold focus:text-xs focus:shadow-lg"
    >
      {lang === 'es' ? 'Saltar al contenido principal' : 'Skip to main content'}
    </a>

    <!-- Header / Navbar -->
    <header class="sticky top-0 z-50 bg-[#133A5A]/95 backdrop-blur-md border-b border-white/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href={lang === 'es' ? '/' : '/en'} class="flex items-center group">
          <img 
            src="/images/logo_blanco.png" 
            alt="Serviproma Energy C.A." 
            class="h-12 sm:h-14 w-auto object-contain group-hover:scale-105 transition-transform" 
          />
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
          {nav[lang].map((item) => (
            <a 
              href={item.href} 
              class={`transition-colors flex items-center gap-1.5 ${currentPath === item.href ? 'text-amber-400 font-semibold' : 'hover:text-amber-400'}`}
            >
              <span>{item.label}</span>
              {item.badge && (
                <span class="px-1.5 py-0.5 text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded font-mono">
                  {item.badge}
                </span>
              )}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-3">
          <!-- Language Selector (Web + Header) -->
          <a 
            href={targetHref} 
            class="group px-3 py-1.5 text-xs font-sans font-semibold text-slate-200 hover:text-white border border-white/15 hover:border-amber-400/60 bg-slate-900/50 hover:bg-slate-900/90 backdrop-blur-sm rounded-full transition-all duration-200 flex items-center gap-2 shadow-sm hover:shadow-amber-500/10"
            title={lang === 'es' ? 'Switch to English' : 'Cambiar a Español'}
          >
            {lang === 'es' ? (
              <>
                <svg class="w-4 h-4 rounded-full shrink-0 overflow-hidden ring-1 ring-white/25 object-cover" viewBox="0 0 512 512" aria-hidden="true">
                  <clipPath id="us-circle-h"><circle cx="256" cy="256" r="256"/></clipPath>
                  <g clip-path="url(#us-circle-h)">
                    <path fill="#bd3d44" d="M0 0h512v512H0"/>
                    <path stroke="#fff" stroke-width="39.4" d="M0 59h512M0 138h512M0 217h512M0 296h512M0 375h512M0 454h512"/>
                    <path fill="#192f5d" d="M0 0h256v276H0"/>
                    <g fill="#fff">
                      <circle cx="48" cy="48" r="11"/><circle cx="104" cy="48" r="11"/><circle cx="160" cy="48" r="11"/><circle cx="216" cy="48" r="11"/>
                      <circle cx="76" cy="94" r="11"/><circle cx="132" cy="94" r="11"/><circle cx="188" cy="94" r="11"/>
                      <circle cx="48" cy="140" r="11"/><circle cx="104" cy="140" r="11"/><circle cx="160" cy="140" r="11"/><circle cx="216" cy="140" r="11"/>
                      <circle cx="76" cy="186" r="11"/><circle cx="132" cy="186" r="11"/><circle cx="188" cy="186" r="11"/>
                      <circle cx="48" cy="232" r="11"/><circle cx="104" cy="232" r="11"/><circle cx="160" cy="232" r="11"/><circle cx="216" cy="232" r="11"/>
                    </g>
                  </g>
                </svg>
                <span class="tracking-wide">English</span>
                <svg class="w-3 h-3 text-slate-400 group-hover:text-amber-400 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                </svg>
              </>
            ) : (
              <>
                <svg class="w-4 h-4 rounded-full shrink-0 overflow-hidden ring-1 ring-white/25" viewBox="0 0 512 512" aria-hidden="true">
                  <clipPath id="es-circle-h"><circle cx="256" cy="256" r="256"/></clipPath>
                  <g clip-path="url(#es-circle-h)">
                    <path fill="#c60b1e" d="M0 0h512v512H0z"/>
                    <path fill="#ffc400" d="M0 128h512v256H0z"/>
                  </g>
                </svg>
                <span class="tracking-wide">Español</span>
                <svg class="w-3 h-3 text-slate-400 group-hover:text-amber-400 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                </svg>
              </>
            )}
          </a>

          <a 
            href={ctaHref} 
            class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-xs uppercase font-heading font-bold tracking-wider rounded border border-[#F2A900] bg-[#F2A900] text-[#1C1F23] hover:bg-[#ffc433] transition-all shadow-md"
          >
            {ctaLabel}
          </a>
          <button id="mobile-menu-btn" type="button" class="md:hidden p-2 text-slate-300 hover:text-white rounded-lg hover:bg-white/5 focus-visible:outline-2 focus-visible:outline-amber-400 transition-colors" aria-label={lang === 'es' ? 'Abrir menú de navegación' : 'Open navigation menu'} aria-expanded="false" aria-controls="mobile-menu">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Menú móvil desplegable -->
      <div id="mobile-menu" class="hidden md:hidden border-b border-slate-800 bg-slate-900/95 backdrop-blur-md px-4 pt-3 pb-6 space-y-2 text-base">
        {nav[lang].map((item) => (
          <a href={item.href} class="flex items-center justify-between text-slate-200 hover:text-amber-400 py-2.5 border-b border-slate-800/60 last:border-0 transition-colors">
            <span>{item.label}</span>
            {item.badge && (
              <span class="px-2 py-0.5 text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded font-mono">
                {item.badge}
              </span>
            )}
          </a>
        ))}
        <div class="pt-4 mt-2 border-t border-slate-800 flex items-center justify-between gap-3">
          <a 
            href={targetHref} 
            class="group inline-flex items-center gap-2.5 px-3.5 py-2 rounded-full border border-white/15 bg-slate-950/70 hover:border-amber-400/60 hover:bg-slate-950 text-xs font-sans font-semibold text-slate-200 hover:text-white transition-all shadow-sm"
          >
            {lang === 'es' ? (
              <>
                <svg class="w-4 h-4 rounded-full shrink-0 overflow-hidden ring-1 ring-white/25" viewBox="0 0 512 512" aria-hidden="true">
                  <clipPath id="us-circle-m"><circle cx="256" cy="256" r="256"/></clipPath>
                  <g clip-path="url(#us-circle-m)">
                    <path fill="#bd3d44" d="M0 0h512v512H0"/>
                    <path stroke="#fff" stroke-width="39.4" d="M0 59h512M0 138h512M0 217h512M0 296h512M0 375h512M0 454h512"/>
                    <path fill="#192f5d" d="M0 0h256v276H0"/>
                    <g fill="#fff">
                      <circle cx="48" cy="48" r="11"/><circle cx="104" cy="48" r="11"/><circle cx="160" cy="48" r="11"/><circle cx="216" cy="48" r="11"/>
                      <circle cx="76" cy="94" r="11"/><circle cx="132" cy="94" r="11"/><circle cx="188" cy="94" r="11"/>
                      <circle cx="48" cy="140" r="11"/><circle cx="104" cy="140" r="11"/><circle cx="160" cy="140" r="11"/><circle cx="216" cy="140" r="11"/>
                      <circle cx="76" cy="186" r="11"/><circle cx="132" cy="186" r="11"/><circle cx="188" cy="186" r="11"/>
                      <circle cx="48" cy="232" r="11"/><circle cx="104" cy="232" r="11"/><circle cx="160" cy="232" r="11"/><circle cx="216" cy="232" r="11"/>
                    </g>
                  </g>
                </svg>
                <span class="tracking-wide">English</span>
                <svg class="w-3 h-3 text-slate-400 group-hover:text-amber-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                </svg>
              </>
            ) : (
              <>
                <svg class="w-4 h-4 rounded-full shrink-0 overflow-hidden ring-1 ring-white/25" viewBox="0 0 512 512" aria-hidden="true">
                  <clipPath id="es-circle-m"><circle cx="256" cy="256" r="256"/></clipPath>
                  <g clip-path="url(#es-circle-m)">
                    <path fill="#c60b1e" d="M0 0h512v512H0z"/>
                    <path fill="#ffc400" d="M0 128h512v256H0z"/>
                  </g>
                </svg>
                <span class="tracking-wide">Español</span>
                <svg class="w-3 h-3 text-slate-400 group-hover:text-amber-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                </svg>
              </>
            )}
          </a>

          <a 
            href={ctaHref} 
            class="sm:hidden inline-flex items-center justify-center px-4 py-2 text-xs uppercase font-heading font-bold tracking-wider rounded border border-[#F2A900] bg-[#F2A900] text-[#1C1F23] hover:bg-[#ffc433] transition-all shadow-md"
          >
            {ctaLabel}
          </a>
        </div>
      </div>
    </header>

    <!-- Contenido principal -->
    <main id="main-content" class="flex-grow">
      <slot />
    </main>

    <!-- Footer Corporativo -->
    <footer class="bg-slate-950 border-t border-slate-800/80 pt-10 sm:pt-16 pb-8 sm:pb-12 text-slate-400 text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-2 lg:grid-cols-12 gap-x-5 gap-y-8 sm:gap-10 mb-8 sm:mb-12">
        <!-- Columna 1: Marca y Propósito -->
        <div class="col-span-2 lg:col-span-4 flex flex-col items-center lg:items-start text-center lg:text-left space-y-3 sm:space-y-4">
          <a href={lang === 'es' ? '/' : '/en'} class="inline-block">
            <img 
              src="/images/logo_blanco.png" 
              alt="Serviproma Energy C.A." 
              class="h-12 sm:h-15 w-auto object-contain opacity-95 hover:opacity-100 transition-opacity mx-auto lg:mx-0" 
            />
          </a>
          <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-slate-900 border border-slate-800 text-[11px] text-amber-400/90 font-mono">
            <span>RIF J-508883055</span>
          </div>
          <p class="text-xs text-slate-300 leading-relaxed font-sans max-w-sm">
            {lang === 'es' 
              ? 'Mantener la energía en servicio con seguridad, precisión técnica y respaldo integral.'
              : 'Maintaining energy in service with safety, technical precision, and comprehensive support.'
            }
          </p>
        </div>

        <!-- Columna 2: Soluciones (1/2 ancho en mobile al lado de Empresa) -->
        <div class="col-span-1 lg:col-span-3 pt-4 lg:pt-0 border-t border-slate-800/70 lg:border-0 text-center lg:text-left">
          <h4 class="text-white font-semibold text-[11px] sm:text-xs tracking-wider uppercase mb-3 sm:mb-4 font-mono flex items-center justify-center lg:justify-start gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>{lang === 'es' ? 'Soluciones' : 'Solutions'}</span>
          </h4>
          <ul class="space-y-2 text-[11px] sm:text-xs">
            <li>
              <a href={lang === 'es' ? '/servicios#protecciones' : '/en/services#protections'} class="hover:text-amber-400 transition-colors block py-0.5 leading-snug">
                {lang === 'es' ? 'Protecciones y Comisionamiento' : 'Protection & Commissioning'}
              </a>
            </li>
            <li>
              <a href={lang === 'es' ? '/servicios#automatizacion' : '/en/services#automation'} class="text-white font-semibold hover:text-amber-400 transition-colors block py-0.5 leading-snug">
                {lang === 'es' ? 'SCADA y IEC 61850' : 'Automation & SCADA (IEC 61850)'}
              </a>
            </li>
            <li>
              <a href={lang === 'es' ? '/slrp' : '/en/slrp'} class="hover:text-amber-400 transition-colors inline-flex flex-wrap items-center justify-center lg:justify-start gap-1.5 py-0.5 leading-snug">
                <span>{lang === 'es' ? 'Sistema SLRP' : 'SLRP Technology'}</span>
                <span class="px-1 py-0.2 text-[9px] font-mono font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded">
                  {lang === 'es' ? 'Exclusivo' : 'Pro'}
                </span>
              </a>
            </li>
            <li>
              <a href={lang === 'es' ? '/servicios#estudios' : '/en/services#studies'} class="hover:text-amber-400 transition-colors block py-0.5 leading-snug">
                {lang === 'es' ? 'Estudios de Potencia' : 'Power Studies'}
              </a>
            </li>
            <li>
              <a href={lang === 'es' ? '/servicios#industria' : '/en/services#industry'} class="text-white font-semibold hover:text-amber-400 transition-colors block py-0.5 leading-snug">
                {lang === 'es' ? 'Industria y Petróleo' : 'Industry & Oil'}
              </a>
            </li>
          </ul>
        </div>

        <!-- Columna 3: Empresa (1/2 ancho en mobile al lado de Soluciones) -->
        <div class="col-span-1 lg:col-span-2 pt-4 lg:pt-0 border-t border-slate-800/70 lg:border-0 text-center lg:text-left">
          <h4 class="text-white font-semibold text-[11px] sm:text-xs tracking-wider uppercase mb-3 sm:mb-4 font-mono flex items-center justify-center lg:justify-start gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
            <span>{lang === 'es' ? 'Empresa' : 'Company'}</span>
          </h4>
          <ul class="space-y-2 text-[11px] sm:text-xs">
            <li>
              <a href={lang === 'es' ? '/nosotros' : '/en/about'} class="hover:text-amber-400 transition-colors block py-0.5 leading-snug">
                {lang === 'es' ? 'Quiénes somos' : 'About Us'}
              </a>
            </li>
            <li>
              <a href={lang === 'es' ? '/nosotros#alcance' : '/en/about#reach'} class="text-white font-semibold hover:text-amber-400 transition-colors block py-0.5 leading-snug">
                {lang === 'es' ? '6 países' : '6 Countries'}
              </a>
            </li>
            <li>
              <a href={lang === 'es' ? '/experiencia' : '/en/experience'} class="text-white font-semibold hover:text-amber-400 transition-colors block py-0.5 leading-snug">
                {lang === 'es' ? 'Casos de Éxito' : 'Track Record'}
              </a>
            </li>
            <li>
              <a href={lang === 'es' ? '/contacto' : '/en/contact'} class="hover:text-amber-400 transition-colors block py-0.5 leading-snug">
                {lang === 'es' ? 'Sede Caracas' : 'Caracas HQ'}
              </a>
            </li>
          </ul>
        </div>

        <!-- Columna 4: Contacto Directo en Tarjeta Táctil (Ancho completo en mobile) -->
        <div class="col-span-2 lg:col-span-3 pt-4 lg:pt-0 border-t border-slate-800/70 lg:border-0">
          <h4 class="text-white font-semibold text-[11px] sm:text-xs tracking-wider uppercase mb-3 sm:mb-4 font-mono flex items-center gap-2">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
            <span>{lang === 'es' ? 'Contacto Directo' : 'Direct Contact'}</span>
          </h4>
          <div class="rounded-lg bg-slate-900/60 border border-slate-800/80 p-3.5 sm:p-0 sm:bg-transparent sm:border-0 space-y-2.5 sm:space-y-3 text-xs">
            <div class="flex items-start gap-2.5 text-slate-300">
              <svg class="w-4 h-4 text-amber-400 mt-0.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
