---
import Logo from './Logo.astro';
import { paths, navOrder, type Lang, type PageKey } from '../i18n/routes';
import { t } from '../i18n';

interface Props { lang: Lang; page: PageKey }
const { lang, page } = Astro.props;
const c = t(lang).common;
const other: Lang = lang === 'es' ? 'en' : 'es';
---
<header class="sticky top-0 z-40 border-b border-slate-800 bg-slate-950">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-5 py-4 sm:px-8">
    <a href={paths.home[lang]} class="shrink-0" aria-label="Serviproma Energy">
      <Logo />
    </a>

    <nav class="hidden items-center gap-8 lg:flex" aria-label="Principal">
      {navOrder.map((key) => (
        <a
          href={paths[key][lang]}
          aria-current={page === key ? 'page' : undefined}
          class:list={[
            'py-2 text-[0.95rem] font-medium transition-colors hover:text-amber-400',
            page === key ? 'text-amber-400 underline decoration-2 underline-offset-8' : 'text-slate-300',
          ]}
        >{c.nav[key]}</a>
      ))}
    </nav>

    <div class="hidden items-center gap-5 lg:flex">
      <a
        href={paths[page][other]}
        hreflang={other === 'es' ? 'es-VE' : 'en'}
        lang={other}
        aria-label={c.langSwitchAria}
        class="text-[0.9rem] font-medium text-slate-300 hover:text-amber-400"
      >{c.langSwitchTo}</a>
      <a
        href={paths.contact[lang]}
        class="bg-amber-400 px-5 py-2.5 text-[0.95rem] font-semibold text-slate-950 transition-colors hover:bg-amber-300"
      >{c.ctaHeader}</a>
    </div>

    <button
      type="button"
      id="menu-toggle"
      class="border border-slate-700 px-4 py-2 text-sm font-medium text-slate-100 lg:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-open={c.menu}
      data-close={c.menuClose}
    >{c.menu}</button>
  </div>

  <div id="mobile-menu" hidden class="border-t border-slate-800 bg-slate-950 lg:hidden">
    <nav class="mx-auto flex max-w-7xl flex-col px-5 py-3 sm:px-8" aria-label="Móvil">
      {navOrder.map((key) => (
        <a
          href={paths[key][lang]}
          aria-current={page === key ? 'page' : undefined}
          class:list={[
            'border-b border-slate-800 py-4 text-lg font-medium',
            page === key ? 'text-amber-400' : 'text-slate-200',
          ]}
        >{c.nav[key]}</a>
      ))}
      <a href={paths.contact[lang]} class="mt-4 bg-amber-400 px-5 py-3.5 text-center text-base font-semibold text-slate-950">{c.ctaHeader}</a>
      <a
        href={paths[page][other]}
        hreflang={other === 'es' ? 'es-VE' : 'en'}
        lang={other}
        aria-label={c.langSwitchAria}
        class="py-5 text-center text-base text-slate-300"
      >{c.langSwitchTo}</a>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('menu-toggle') as HTMLButtonElement | null;
  const panel = document.getElementById('mobile-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.textContent = open ? btn.dataset.open ?? '' : btn.dataset.close ?? '';
    if (panel) panel.hidden = open;
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') btn.click();
  });
</script>
