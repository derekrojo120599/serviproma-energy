---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Experience & Case Studies | Serviproma Energy" 
  description="Proven track record in bulk substations, transmission lines, and industrial facilities up to 765 kV across the Americas and Africa."
  lang="en" 
  currentPath="/en/experience"
>
  <!-- Hero Experience with Substation Panorama -->
  <section class="relative py-24 border-b border-slate-800 bg-slate-950 overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img 
        src="/images/subestacion-valle-montana.jpg" 
        alt="High-voltage substation and switchyard equipment" 
        class="w-full h-full object-cover opacity-20"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-slate-950/95 to-slate-950"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-4xl relative z-10">
      <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block mb-3 font-mono">Proven Technical Track Record</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">Proven Field Experience in Bulk Power Grids</h1>
      <p class="mt-4 text-slate-300 text-base leading-relaxed max-w-3xl mx-auto">
        More than three decades of combined senior expertise executing protection, testing, and automation projects for leading utility companies and heavy industries.
      </p>
    </div>
  </section>

  <!-- Projects by Region -->
  <section class="py-24 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-24">
      
      <!-- Experience in Venezuela -->
      <div>
        <div class="flex items-center gap-3 mb-8">
          <span class="text-3xl">🇻🇪</span>
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Venezuela · Power Utilities & Industry</h2>
            <span class="text-xs text-slate-400 font-mono">CORPOELEC (Transmission & Dispatch) · PEQUIVEN</span>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <div class="rounded-2xl bg-slate-900/60 border border-slate-800 overflow-hidden flex flex-col group hover:border-slate-700 transition-colors shadow-xl">
            <div class="h-52 overflow-hidden relative">
              <img 
                src="/images/refineria-petroleo.jpg" 
                alt="PEQUIVEN Methanol Complex" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded bg-slate-950/80 border border-amber-500/30 text-[10px] font-mono text-amber-400 font-bold uppercase tracking-wider">
                2024 · Petrochemicals
              </span>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-xl font-bold text-white mb-2">PEQUIVEN – Metanol de Oriente</h3>
                <p class="text-xs text-slate-300 leading-relaxed mb-4">
                  Full configuration, commissioning, and start-up of integrated control and protection systems for substations in Plant 1 and Plant 2.
                </p>
              </div>
              <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <span class="text-[11px] px-2.5 py-1 rounded bg-slate-800 text-slate-300 font-mono">Commissioning · Control</span>
                <span class="text-xs text-amber-400 font-mono">13.8 kV to 115 kV</span>
              </div>
            </div>
          </div>

          <div class="rounded-2xl bg-slate-900/60 border border-slate-800 overflow-hidden flex flex-col group hover:border-slate-700 transition-colors shadow-xl">
            <div class="h-52 overflow-hidden relative">
              <img 
                src="/images/subestacion-porticos.jpg" 
                alt="Bulk transmission substations in national power grid" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded bg-slate-950/80 border border-amber-500/30 text-[10px] font-mono text-amber-400 font-bold uppercase tracking-wider">
                National Power Grid
              </span>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-xl font-bold text-white mb-2">CORPOELEC · Transmission & Dispatch</h3>
                <p class="text-xs text-slate-300 leading-relaxed mb-4">
                  Field engineering and substation automation across bulk substations from 115 kV to 765 kV in Western and Andean regional grids.
                </p>
              </div>
              <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <span class="text-[11px] px-2.5 py-1 rounded bg-slate-800 text-slate-300 font-mono">High & Extra-High Voltage</span>
                <span class="text-xs text-amber-400 font-mono">up to 765 kV</span>
              </div>
            </div>
          </div>

        </div>
      </div>

      <!-- Experience in Chile -->
      <div class="pt-12 border-t border-slate-800/80">
        <div class="flex items-center gap-3 mb-8">
          <span class="text-3xl">🇨🇱</span>
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Chile · Transmission, Generation & Mining</h2>
            <span class="text-xs text-slate-400 font-mono">Elecnor · Transelec · Enel · Enfragen</span>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <div class="rounded-2xl bg-slate-900/60 border border-slate-800 overflow-hidden flex flex-col group hover:border-slate-700 transition-colors shadow-xl">
            <div class="h-44 overflow-hidden relative">
              <img 
                src="/images/substation-hero.jpg" 
                alt="S/E Cumbres 500 kV in Chile" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-slate-950/80 border border-amber-500/30 text-[10px] font-mono text-amber-400 font-bold">
                Elecnor · 500 kV
              </span>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-bold text-white mb-2">S/E Cumbres 500 kV</h3>
                <p class="text-xs text-slate-300 leading-relaxed">
                  FAT and SAT testing, advanced control system parameterization, and scheme verification on a 750 MVA ATR transformer bank for Elecnor.
                </p>
              </div>
              <span class="text-[11px] font-mono text-amber-400/90 mt-4 block">750 MVA ATR Bank</span>
            </div>
          </div>

          <div class="rounded-2xl bg-slate-900/60 border border-slate-800 overflow-hidden flex flex-col group hover:border-slate-700 transition-colors shadow-xl">
            <div class="h-44 overflow-hidden relative">
              <img 
                src="/images/benchmarks/eda-substation-night.jpg" 
                alt="S/E Kimal and Los Changos 220 kV" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-slate-950/80 border border-amber-500/30 text-[10px] font-mono text-amber-400 font-bold">
                Transelec · 220 kV
              </span>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-bold text-white mb-2">S/E Kimal & Los Changos</h3>
                <p class="text-xs text-slate-300 leading-relaxed">
                  Commissioning and start-up of protection and control systems for transmission line and transformer bays for Transelec.
                </p>
              </div>
              <span class="text-[11px] font-mono text-amber-400/90 mt-4 block">Line & Trafo Bays</span>
            </div>
          </div>

          <div class="rounded-2xl bg-slate-900/60 border border-slate-800 overflow-hidden flex flex-col group hover:border-slate-700 transition-colors shadow-xl">
            <div class="h-44 overflow-hidden relative">
              <img 
                src="/images/benchmarks/scadatech-sistemas.png" 
                alt="Framework contracts with Enfragen and Enel across 14 power plants" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-slate-950/80 border border-amber-500/30 text-[10px] font-mono text-amber-400 font-bold">
                14 Plants
              </span>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-lg font-bold text-white mb-2">Enfragen / Enel (Framework Contracts)</h3>
                <p class="text-xs text-slate-300 leading-relaxed">
                  Specialized maintenance, post-fault analysis, and technical training across 9 Enfragen generation facilities and 5 Enel thermal power plants.
                </p>
              </div>
              <span class="text-[11px] font-mono text-amber-400/90 mt-4 block">Maintenance & Diagnostics</span>
            </div>
          </div>

        </div>
      </div>

      <!-- Other International Projects -->
      <div class="pt-12 border-t border-slate-800/80">
        <div class="flex items-center gap-3 mb-8">
          <span class="text-3xl">🌎</span>
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Other International Projects</h2>
            <span class="text-xs text-slate-400 font-mono">Colombia · Mexico · Ivory Coast · Cameroon</span>
          </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          
          <div class="rounded-2xl bg-slate-900/60 border border-slate-800 overflow-hidden flex flex-col group hover:border-slate-700 transition-colors shadow-xl">
            <div class="h-48 overflow-hidden relative">
              <img 
                src="/images/engineers-field.jpg" 
                alt="S/E Juana La Avanzadora in Colombia" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded bg-slate-950/80 border border-amber-500/30 text-[10px] font-mono text-amber-400 font-bold uppercase tracking-wider">
                Colombia · 230 kV
              </span>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-xl font-bold text-white mb-2">S/E Juana La Avanzadora</h3>
                <p class="text-xs text-slate-300 leading-relaxed mb-4">
                  Specialized engineering services, protection calibration, and commissioning in a regional transmission interconnection substation.
                </p>
              </div>
              <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <span class="text-[11px] font-mono text-slate-400">Regional Interconnection</span>
                <span class="text-xs text-amber-400 font-mono">230 kV</span>
              </div>
            </div>
          </div>

          <div class="rounded-2xl bg-slate-900/60 border border-slate-800 overflow-hidden flex flex-col group hover:border-slate-700 transition-colors shadow-xl">
            <div class="h-48 overflow-hidden relative">
              <img 
                src="/images/benchmarks/pace-tableros-integrados.webp" 
                alt="Integrated panels for international thermal and industrial plants" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded bg-slate-950/80 border border-amber-500/30 text-[10px] font-mono text-amber-400 font-bold uppercase tracking-wider">
                Mexico & Africa
              </span>
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <h3 class="text-xl font-bold text-white mb-2">Industrial & Thermal Projects</h3>
                <p class="text-xs text-slate-300 leading-relaxed mb-4">
                  Engineering interventions, relay settings, and parameterization across industrial complexes and distribution substations in Ivory Coast and Cameroon.
                </p>
              </div>
              <div class="pt-4 border-t border-slate-800/80 flex items-center justify-between">
                <span class="text-[11px] font-mono text-slate-400">Generation & Distribution</span>
                <span class="text-xs text-amber-400 font-mono">90 kV to 225 kV</span>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>
</Layout>
