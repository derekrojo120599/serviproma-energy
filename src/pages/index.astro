---
import Layout from '../layouts/Layout.astro';

const heroSlides = [
  {
    src: '/images/subestacion-valle-montana.jpg',
    alt: 'Subestación de alta tensión y equipos de patio',
    label: 'Subestación troncal 765 kV',
  },
  {
    src: '/images/benchmarks/eda-substation-night.jpg',
    alt: 'Subestación de potencia 500 kV vista nocturna',
    label: 'Subestación troncal 500 kV',
  },
  {
    src: '/images/sala-control-tableros.jpg',
    alt: 'Sala de control con tableros de protección y control',
    label: 'Sala de control · SAS / RTU',
  },
  {
    src: '/images/benchmarks/pace-hero-equipo.webp',
    alt: 'Especialistas de ingeniería en patio de subestación',
    label: 'Ingeniería y pruebas FAT/SAT en campo',
  },
  {
    src: '/images/torre-transmision-ciudad.jpg',
    alt: 'Líneas de transmisión e infraestructura de alta tensión',
    label: 'Interconexión y líneas de transmisión',
  },
];
---

<Layout title="Serviproma Energy | Control, Protecciones y SCADA en Alta Tensión" lang="es" currentPath="/">
  
  <!-- HERO SECTION: IMPACTO INDUSTRIAL Y AUTORIDAD TÉCNICA -->
  <section class="relative min-h-[92vh] flex flex-col justify-between border-b border-slate-800/80 bg-slate-950 overflow-hidden">
    <!-- SLIDER DE FONDO DE ALTA TENSIÓN (Rotación de izquierda a derecha) -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden" id="hero-slider-container">
      <div id="hero-slider-track" class="relative w-full h-full">
        {heroSlides.map((slide, idx) => (
          <div 
            class={`hero-slide absolute inset-0 w-full h-full will-change-transform ${idx === 0 ? 'active' : ''}`}
            data-index={idx}
            data-label={slide.label}
            style={`opacity: ${idx === 0 ? '1' : '0'}; transform: translateX(${idx === 0 ? '0%' : '-100%'}); z-index: ${idx === 0 ? '1' : '0'};`}
          >
            <img 
              src={slide.src} 
              alt={slide.alt} 
              class="w-full h-full object-cover object-[right_bottom]"
              loading={idx === 0 ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>

      <!-- Easing gradient continuo: bloque oscuro a la izquierda que se abre nítidamente hacia la subestación -->
      <div 
        class="absolute inset-0 z-10"
        style="background: linear-gradient(to right, rgb(2 6 23 / 1) 0%, rgb(2 6 23 / 0.98) 28%, rgb(2 6 23 / 0.88) 42%, rgb(2 6 23 / 0.5) 60%, rgb(2 6 23 / 0.15) 75%, transparent 90%);"
      ></div>
      <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-slate-950 via-slate-950/70 to-transparent z-10"></div>
    </div>

    <!-- Contenido Principal del Hero -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-10 relative z-10 w-full my-auto">
      <div class="max-w-2xl lg:max-w-3xl space-y-7">
        
        <!-- Badge institucional de alta precisión -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded border border-amber-500/30 bg-slate-900/80 text-amber-400 text-xs font-mono font-medium tracking-wider uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
          <span>Ingeniería en Sistemas de Potencia · 13.8 kV a 765 kV</span>
        </div>

        <!-- Titular Principal de Alto Contraste -->
        <h1 class="text-4xl sm:text-6xl lg:text-[4rem] font-extrabold text-white tracking-tight leading-[1.08]">
          Control, protecciones y SCADA en alta y extra alta tensión
        </h1>

        <!-- Bajada de valor técnico directo -->
        <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-normal max-w-2xl">
          El respaldo de ingenieros especialistas con más de 35 años operando en subestaciones energizadas y 12 años de trayectoria directa en el Despacho de Carga y Transmisión de CORPOELEC.
        </p>

        <!-- CTAs sin distracciones -->
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a 
            href="/contacto" 
            class="px-7 py-3.5 bg-amber-500 hover:bg-amber-400 text-slate-950 font-mono font-bold text-xs uppercase tracking-wider rounded border border-amber-500 transition-all text-center"
          >
            Solicitar Evaluación Técnica
          </a>
          <a 
            href="#pilares" 
            class="px-7 py-3.5 border border-slate-700 bg-slate-900/90 hover:bg-slate-800 text-slate-200 hover:text-white font-mono text-xs uppercase tracking-wider rounded transition-all text-center flex items-center justify-center gap-2"
          >
            <span>Pilares de Operación</span>
            <span class="text-amber-400 font-mono">↓</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Indicadores de Telemetría del Slider (Versión Web) -->
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pb-4 hidden sm:flex items-center justify-between text-xs text-slate-400">
      <div class="flex items-center gap-2 font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
        <span id="slider-caption" class="text-slate-300 text-xs font-semibold tracking-wider uppercase transition-opacity duration-300">
          Subestación troncal 765 kV
        </span>
      </div>

      <!-- Barra de progreso e indicadores interactivos -->
      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1.5" id="slider-dots">
          {heroSlides.map((slide, idx) => (
            <button 
              type="button" 
              class={`slider-dot h-1.5 rounded-full transition-all duration-500 cursor-pointer ${idx === 0 ? 'w-8 bg-amber-400 shadow-sm shadow-amber-400/50' : 'w-3 bg-slate-700 hover:bg-slate-500'}`}
              data-dot-index={idx}
              title={slide.label}
              aria-label={`Ver diapositiva: ${slide.label}`}
            ></button>
          ))}
        </div>
        <span class="font-mono text-[11px] text-slate-400 ml-1" id="slider-counter">01 / 05</span>
      </div>
    </div>

    <!-- Barra de Métricas y Autoridad Anclada al Hero -->
    <div class="relative z-10 border-t border-slate-800/80 bg-slate-950/85 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 divide-y sm:divide-y-0 sm:divide-x divide-slate-800/80">
          <div class="pt-2 sm:pt-0 sm:pr-6">
            <div class="text-3xl sm:text-4xl font-bold text-white font-['IBM_Plex_Mono'] tracking-tight">+35</div>
            <div class="text-[11px] sm:text-xs text-slate-400 uppercase tracking-wider mt-0.5 font-mono">Años de experiencia del equipo</div>
          </div>
          <div class="pt-2 sm:pt-0 sm:px-6">
            <div class="text-3xl sm:text-4xl font-bold text-amber-400 font-['IBM_Plex_Mono'] tracking-tight">765 kV</div>
            <div class="text-[11px] sm:text-xs text-slate-400 uppercase tracking-wider mt-0.5 font-mono">Máxima tensión intervenida</div>
          </div>
          <div class="pt-2 sm:pt-0 sm:px-6">
            <div class="text-3xl sm:text-4xl font-bold text-white font-['IBM_Plex_Mono'] tracking-tight">6 Países</div>
            <div class="text-[11px] sm:text-xs text-slate-400 uppercase tracking-wider mt-0.5 font-mono">América y África</div>
          </div>
          <div class="pt-2 sm:pt-0 sm:pl-6">
            <div class="text-3xl sm:text-4xl font-bold text-amber-400 font-['IBM_Plex_Mono'] tracking-tight">+20</div>
            <div class="text-[11px] sm:text-xs text-slate-400 uppercase tracking-wider mt-0.5 font-mono">Grandes industrias atendidas</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PILAR 1: LA EXPERIENCIA DEL PERSONAL (AUTORIDAD TÉCNICA Y CASOS REALES) -->
  <section id="pilares" class="py-24 border-b border-slate-800/80 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-16">
        <div class="lg:col-span-7 space-y-4">
          <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block font-mono">PILAR 01 · RESPALDO HUMANO SENIOR</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
            No improvisamos: el respaldo de ingenieros que ya operaron las redes más exigentes
          </h2>
          <p class="text-slate-300 text-base leading-relaxed">
            En sistemas eléctricos de potencia, el valor real no radica en una fecha de registro mercantil, sino en el criterio técnico de los especialistas de campo. Nuestro equipo senior acumula más de 35 años de experiencia combinada resolviendo perturbaciones y comisionando subestaciones de 13.8 kV a 765 kV.
          </p>
        </div>

        <div class="lg:col-span-5 bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-2xl">
          <div class="h-44 overflow-hidden relative">
            <img 
              src="/images/engineers-field.jpg" 
              alt="Especialistas de ingeniería en patio de subestación de alta tensión" 
              class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
            <div class="absolute top-3 right-3 px-2.5 py-1 rounded bg-slate-950/80 backdrop-blur-md border border-amber-500/30 text-[10px] font-mono text-amber-400 font-bold uppercase tracking-wider">
              Operación Energizada
            </div>
          </div>
          <div class="p-6">
            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 font-mono">Solvencia de Campo Demostrada</div>
            <ul class="space-y-3.5 text-xs text-slate-300">
              <li class="flex items-start gap-3">
                <span class="text-amber-400 font-mono text-[11px] font-bold shrink-0 mt-0.5">[01]</span>
                <span><strong>12 años directos en CORPOELEC:</strong> Despacho de Carga y Transmisión en regiones Los Andes y Occidente.</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-amber-400 font-mono text-[11px] font-bold shrink-0 mt-0.5">[02]</span>
                <span><strong>Industria y petroquímica:</strong> Comisionamiento y sistemas de control en PEQUIVEN Metanol de Oriente (Planta 1 y 2).</span>
              </li>
              <li class="flex items-start gap-3">
                <span class="text-amber-400 font-mono text-[11px] font-bold shrink-0 mt-0.5">[03]</span>
                <span><strong>Contratistas globales:</strong> Intervención de bahías bajo estándares normativos de Elecnor, Transelec y Enel.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 4 Bloques Técnicos de Especialidad -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        <div class="p-6 bg-slate-900/60 border border-slate-800 rounded">
          <div class="text-2xl font-bold text-white font-['IBM_Plex_Mono'] mb-1">765 kV</div>
          <h3 class="text-sm font-bold text-amber-400 mb-2">Alta y Extra Alta Tensión</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Intervención directa en subestaciones troncales de 765, 400, 230 y 115 kV. Dominio de la dinámica del Sistema Eléctrico Nacional.
          </p>
        </div>

        <div class="p-6 bg-slate-900/60 border border-slate-800 rounded">
          <div class="text-2xl font-bold text-white font-['IBM_Plex_Mono'] mb-1">FAT / SAT</div>
          <h3 class="text-sm font-bold text-amber-400 mb-2">Comisionamiento Riguroso</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Inyección secundaria y primaria con maletas de precisión Omicron y Ponovo para calibrar protecciones y evitar disparos erráticos.
          </p>
        </div>

        <div class="p-6 bg-slate-900/60 border border-slate-800 rounded">
          <div class="text-2xl font-bold text-white font-['IBM_Plex_Mono'] mb-1">IEC 61850</div>
          <h3 class="text-sm font-bold text-amber-400 mb-2">Subestaciones Digitales</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Configuración de bus de estación (MMS), mensajes GOOSE, RTUs Siemens SICAM y telecontrol hacia centros de despacho.
          </p>
        </div>

        <div class="p-6 bg-slate-900/60 border border-slate-800 rounded">
          <div class="text-2xl font-bold text-white font-['IBM_Plex_Mono'] mb-1">6 Países</div>
          <h3 class="text-sm font-bold text-amber-400 mb-2">Alcance Internacional</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Experiencia comprobada en Venezuela, Chile (500 kV y 220 kV), Colombia (230 kV), México, Costa de Marfil y Camerún.
          </p>
        </div>
      </div>

      <!-- Casos Emblemáticos Donde Nuestro Personal Ya Lideró -->
      <div class="border border-slate-800 bg-slate-900/40 rounded-xl p-6 sm:p-8">
        <div class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-6 font-mono flex items-center justify-between">
          <span>Infraestructura donde nuestro equipo ya demostró resultados técnicos:</span>
          <span class="hidden sm:inline text-slate-500 text-[11px]">América Latina · 115 kV a 765 kV</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <!-- Caso 1: S/E Cumbres 500 kV -->
          <div class="border border-slate-800 bg-slate-950 rounded-lg overflow-hidden flex flex-col group hover:border-slate-700 transition-colors">
            <div class="h-44 overflow-hidden relative">
              <img 
                src="/images/substation-hero.jpg" 
                alt="S/E Cumbres 500 kV en Chile" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-slate-950/80 backdrop-blur-sm border border-slate-700 text-[10px] font-mono text-amber-400 font-semibold">
                500 kV · Chile
              </span>
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <strong class="text-white block text-sm font-bold mb-1">S/E Cumbres (ATR 750 MVA)</strong>
                <span class="text-xs text-slate-400 leading-relaxed block">
                  Pruebas FAT/SAT y configuración integral del sistema de control y protecciones en banco de 750 MVA para Elecnor.
                </span>
              </div>
              <div class="pt-3 mt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400 font-mono">
                <span>Cliente: Elecnor</span>
                <span class="text-amber-400">SAT / SAS</span>
              </div>
            </div>
          </div>

          <!-- Caso 2: PEQUIVEN Metanol -->
          <div class="border border-slate-800 bg-slate-950 rounded-lg overflow-hidden flex flex-col group hover:border-slate-700 transition-colors">
            <div class="h-44 overflow-hidden relative">
              <img 
                src="/images/refineria-petroleo.jpg" 
                alt="Complejo PEQUIVEN Metanol de Oriente" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-slate-950/80 backdrop-blur-sm border border-slate-700 text-[10px] font-mono text-amber-400 font-semibold">
                Petroquímica · Venezuela
              </span>
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <strong class="text-white block text-sm font-bold mb-1">PEQUIVEN · Metanol de Oriente</strong>
                <span class="text-xs text-slate-400 leading-relaxed block">
                  Configuración, comisionamiento y puesta en servicio de sistemas de control en subestaciones de Planta 1 y Planta 2.
                </span>
              </div>
              <div class="pt-3 mt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400 font-mono">
                <span>Sector: Petroquímica</span>
                <span class="text-amber-400">Control SCADA</span>
              </div>
            </div>
          </div>

          <!-- Caso 3: S/E Kimal y Los Changos -->
          <div class="border border-slate-800 bg-slate-950 rounded-lg overflow-hidden flex flex-col group hover:border-slate-700 transition-colors">
            <div class="h-44 overflow-hidden relative">
              <img 
                src="/images/subestacion-porticos.jpg" 
                alt="S/E Kimal y Los Changos 220 kV" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-slate-950/80 backdrop-blur-sm border border-slate-700 text-[10px] font-mono text-amber-400 font-semibold">
                220 kV · Chile
              </span>
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <strong class="text-white block text-sm font-bold mb-1">S/E Kimal y Los Changos</strong>
                <span class="text-xs text-slate-400 leading-relaxed block">
                  Puesta en servicio y parametrización de bahías de control y protecciones de línea y transformación para Transelec.
                </span>
              </div>
              <div class="pt-3 mt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400 font-mono">
                <span>Cliente: Transelec</span>
                <span class="text-amber-400">Bahías 220 kV</span>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- PILAR 2: LOS SERVICIOS Y SOLUCIONES TÉCNICAS -->
  <section class="py-24 border-b border-slate-800/80 bg-slate-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-16">
        <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block font-mono">PILAR 02 · ALCANCE TÉCNICO ESPECIALIZADO</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
          Soluciones de ingeniería para sistemas de potencia
        </h2>
        <p class="mt-3 text-slate-400 text-base">
          Cubrimos el ciclo de vida completo: desde el diagnóstico y la ingeniería de detalle hasta las pruebas en fábrica (FAT) y la energización en terreno (SAT).
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Servicio 1 -->
        <div class="border border-slate-800 bg-slate-950 rounded overflow-hidden flex flex-col justify-between">
          <div>
            <div class="h-52 overflow-hidden">
              <img 
                src="/images/benchmarks/pace-pruebas-omicron.webp" 
                alt="Pruebas de inyección secundaria con maleta Omicron a relés de protección" 
                class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6">
              <div class="text-xs text-amber-400 font-semibold uppercase tracking-wider mb-2 font-mono">Multimarca</div>
              <h3 class="text-xl font-bold text-white mb-2">Protecciones y Comisionamiento</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">
                Parametrización y pruebas de relés de línea (21/87L), transformador (87T), diferencial de barra (87B), generadores y 50BF en Siemens SIPROTEC 4/5, ABB, GE, SEL y Schneider.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a href="/servicios#protecciones" class="text-xs font-bold text-amber-400 hover:text-amber-300 inline-flex items-center gap-1 uppercase tracking-wider font-mono">
              Ver alcance de protecciones <span>→</span>
            </a>
          </div>
        </div>

        <!-- Servicio 2 -->
        <div class="border border-slate-800 bg-slate-950 rounded overflow-hidden flex flex-col justify-between">
          <div>
            <div class="h-52 overflow-hidden">
              <img 
                src="/images/benchmarks/scadatech-sistemas.png" 
                alt="Pantallas HMI y supervisión SCADA de subestación en tiempo real" 
                class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6">
              <div class="text-xs text-amber-400 font-semibold uppercase tracking-wider mb-2 font-mono">IEC 61850 & Despacho</div>
              <h3 class="text-xl font-bold text-white mb-2">Automatización y SCADA</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">
                Subestaciones digitales, RTUs Siemens SICAM (A8000, AK3, TM1703), gateways y telecontrol hacia centros de despacho de carga vía protocolos IEC 60870-5-101/104, DNP3 e ICCP.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a href="/servicios#automatizacion" class="text-xs font-bold text-amber-400 hover:text-amber-300 inline-flex items-center gap-1 uppercase tracking-wider font-mono">
              Ver arquitectura SCADA <span>→</span>
            </a>
          </div>
        </div>

        <!-- Servicio 3 -->
        <div class="border border-slate-800 bg-slate-950 rounded overflow-hidden flex flex-col justify-between">
          <div>
            <div class="h-52 overflow-hidden">
              <img 
                src="/images/refineria-petroleo.jpg" 
                alt="Refinería y subestaciones de proceso continuo" 
                class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6">
              <div class="text-xs text-amber-400 font-semibold uppercase tracking-wider mb-2 font-mono">Petroquímica & Refinación</div>
              <h3 class="text-xl font-bold text-white mb-2">Industria y Petróleo</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">
                Subestaciones de planta y CCM en media y alta tensión. Protección diferencial de grandes motores, generadores de proceso y esquemas de bote de carga rápido para evitar paradas no programadas.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a href="/servicios#industria" class="text-xs font-bold text-amber-400 hover:text-amber-300 inline-flex items-center gap-1 uppercase tracking-wider font-mono">
              Ver soluciones de planta <span>→</span>
            </a>
          </div>
        </div>

      </div>

      <!-- Solución Tecnológica Exclusiva: SLRP -->
      <div class="mt-12 border border-slate-800 bg-slate-950 rounded-2xl overflow-hidden grid grid-cols-1 lg:grid-cols-12 shadow-2xl">
        <div class="lg:col-span-7 p-8 sm:p-10 flex flex-col justify-between">
          <div>
            <div class="inline-flex items-center gap-2 text-xs font-bold text-amber-400 uppercase tracking-widest font-mono mb-3">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
