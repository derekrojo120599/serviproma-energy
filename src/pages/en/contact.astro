---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Contact & Engineering Quotations | Serviproma Energy" 
  description="Contact our senior engineering team for substation commissioning, protection studies, SAS automation, and SLRP implementation."
  lang="en" 
  currentPath="/en/contact"
>
  <!-- Hero Contact with Atmospheric Transmission Background -->
  <section class="relative py-24 border-b border-slate-800 bg-slate-950 overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img 
        src="/images/benchmarks/eda-hero-poster.webp" 
        alt="Power transmission lines and grid infrastructure at dusk" 
        class="w-full h-full object-cover opacity-25"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-slate-950/95 to-slate-950"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl relative z-10">
      <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block mb-3 font-mono">Direct Engineering Attention</span>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">Let’s Discuss Your Next Substation Project</h1>
      <p class="mt-4 text-slate-300 text-base leading-relaxed">
        Our senior engineering specialists are ready to assess your requirements for protection engineering, testing, power system studies, or SCADA/SLRP integration.
      </p>
    </div>
  </section>

  <!-- Channels and Form -->
  <section class="py-24 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 lg:grid-cols-12 gap-12">
      
      <!-- Corporate Info -->
      <div class="lg:col-span-5 space-y-6">
        <div class="rounded-2xl bg-slate-900 border border-slate-800 overflow-hidden shadow-2xl">
          <div class="h-44 overflow-hidden relative">
            <img 
              src="/images/benchmarks/pace-hero-equipo.webp" 
              alt="Serviproma Energy senior engineers coordinating technical field support" 
              class="w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/30 to-transparent"></div>
            <span class="absolute top-3 left-3 px-2.5 py-1 rounded bg-slate-950/80 border border-amber-500/30 text-[10px] font-mono text-amber-400 font-bold uppercase tracking-wider">
              National & Regional Deployment
            </span>
          </div>
          <div class="p-6">
            <h3 class="text-xl font-bold text-white mb-2">Corporate Information</h3>
            <p class="text-xs text-slate-400 leading-relaxed">
              We serve nationwide requirements across Venezuela and international commissioning and consulting contracts throughout Latin America and the Caribbean.
            </p>
          </div>
        </div>

        <div class="space-y-4">
          <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-lg shrink-0">
              📍
            </div>
            <div>
              <div class="text-xs text-slate-400 font-medium">Headquarters</div>
              <div class="text-sm font-semibold text-white mt-0.5">Av. Las Mercedes, Edif. EXPO 3A, Of. 1-A, Caracas, Venezuela</div>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-lg shrink-0">
              ✉️
            </div>
            <div>
              <div class="text-xs text-slate-400 font-medium">Direct Email</div>
              <a href="mailto:admin@servipromaenergy.com" class="text-sm font-semibold text-amber-400 hover:underline mt-0.5 block">
                admin@servipromaenergy.com
              </a>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 flex items-start gap-4">
            <div class="w-10 h-10 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center font-bold text-lg shrink-0">
              📞
            </div>
            <div>
              <div class="text-xs text-slate-400 font-medium">Phone / Engineering WhatsApp</div>
              <a href="tel:+584127251017" class="text-sm font-semibold text-white hover:text-amber-400 mt-0.5 block">
                +58 412 725 1017
              </a>
            </div>
          </div>

          <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800">
            <div class="text-xs text-slate-400 font-medium">Tax Registration</div>
            <div class="text-sm font-semibold text-white mt-1">Serviproma Energy C.A.</div>
            <div class="text-xs text-slate-400 font-mono">RIF: J-508883055</div>
          </div>
        </div>
      </div>

      <!-- Contact Form -->
      <div class="lg:col-span-7">
        <div class="p-8 sm:p-10 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl">
          <h3 class="text-2xl font-bold text-white mb-2">Technical Assessment Request</h3>
          <p class="text-slate-400 text-xs mb-8">Please complete the form and our senior engineering team will respond within 24 business hours.</p>
          
          <form class="space-y-5">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Full Name *</label>
                <input type="text" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500" placeholder="John Doe, P.E." />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Company / Organization *</label>
                <input type="text" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500" placeholder="Power Utility / EPC Contractor / Industrial Facility" />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Corporate Email *</label>
                <input type="email" required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500" placeholder="jdoe@company.com" />
              </div>
              <div>
                <label class="block text-xs font-semibold text-slate-300 mb-1">Phone Number</label>
                <input type="tel" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500" placeholder="+1..." />
              </div>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Specialty or Service of Interest *</label>
              <select required class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500">
                <option value="">Select an engineering area...</option>
                <option value="protections">Electrical Protections & FAT/SAT Testing</option>
                <option value="scada">Substation Automation (IEC 61850) & SCADA Integration</option>
                <option value="slrp">SLRP Remote Oscillogram Retrieval Solution</option>
                <option value="studies">Power System Studies, Short-Circuit & Load Flow</option>
                <option value="industry">Protection & MCC for Industrial & Oil Facilities</option>
                <option value="other">General Engineering Consulting</option>
              </select>
            </div>

            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">Technical Scope Description *</label>
              <textarea required rows="4" class="w-full bg-slate-950 border border-slate-800 rounded-lg px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-amber-500" placeholder="Indicate voltage level (kV), installed relay/RTU brands, problem to solve, or project scope..."></textarea>
            </div>

            <button type="submit" class="w-full py-4 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider rounded-lg transition-all shadow-xl shadow-amber-500/20 active:scale-95">
              Submit Request to Engineering Team →
            </button>
          </form>
        </div>
      </div>

    </div>
  </section>
</Layout>
