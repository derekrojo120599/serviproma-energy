---
import Layout from '../../layouts/Layout.astro';
---

<Layout 
  title="Contact & Technical Assessment | Serviproma Energy C.A." 
  description="Direct channel with specialized power systems engineers for substation commissioning, protection studies, SAS automation, and SLRP implementation."
  lang="en" 
  currentPath="/en/contact"
>
  <!-- Hero Contact -->
  <section class="relative py-14 sm:py-24 border-b border-slate-800 bg-slate-950 overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img 
        src="/images/benchmarks/eda-substation-night.jpg" 
        alt="Power transmission lines and substation infrastructure" 
        class="w-full h-full object-cover opacity-20"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-slate-950/95 to-slate-950"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-mono font-semibold tracking-wider uppercase mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span>Direct Power Engineering Channel</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        Technical Assessment for Substations & Grids
      </h1>
      <p class="mt-4 text-slate-300 text-base leading-relaxed">
        Connect directly with our senior power engineers to request proposals for FAT/SAT commissioning, SCADA integration, SLRP feasibility, or post-fault forensic analysis.
      </p>
    </div>
  </section>

  <!-- Main Section: Corporate Channels + Engineering Form -->
  <section class="py-14 sm:py-24 bg-slate-950 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Left: Corporate Information & SLAs -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Headquarters & Deployment Card -->
          <div class="rounded-xl bg-slate-900 border border-slate-800 overflow-hidden shadow-2xl">
            <div class="h-44 overflow-hidden relative">
              <img 
                src="/images/benchmarks/pace-hero-equipo.webp" 
                alt="Field engineers coordinating technical support" 
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded bg-slate-950/80 border border-amber-500/30 text-[10px] font-mono text-amber-400 font-bold uppercase tracking-wider">
                National & Regional Deployment
              </span>
            </div>
            <div class="p-6">
              <h3 class="text-lg font-bold text-white mb-2 tracking-tight">Headquarters & Operational Base</h3>
              <p class="text-xs text-slate-300 leading-relaxed">
                Central headquarters in Caracas with rapid field mobilization capability to substations and industrial facilities across Venezuela, Chile, and regional international markets.
              </p>
            </div>
          </div>

          <!-- Direct Channels -->
          <div class="space-y-3 font-mono">
            <!-- Location -->
            <div class="p-4 rounded-lg bg-slate-900/70 border border-slate-800 flex items-start gap-3.5">
              <div class="w-8 h-8 rounded bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              </div>
              <div class="text-xs font-sans">
                <div class="text-slate-400 font-mono text-[10px] uppercase tracking-wider font-semibold">Headquarters & Operational Office</div>
                <div class="text-slate-200 mt-1 font-medium leading-relaxed">Av. Las Mercedes, Edif. EXPO 3A, Of. 1-A, Caracas, Venezuela</div>
              </div>
            </div>

            <!-- Email -->
            <div class="p-4 rounded-lg bg-slate-900/70 border border-slate-800 flex items-start gap-3.5">
              <div class="w-8 h-8 rounded bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div class="text-xs font-sans">
                <div class="text-slate-400 font-mono text-[10px] uppercase tracking-wider font-semibold">Tenders & Projects Department</div>
                <a href="mailto:admin@servipromaenergy.com" class="text-amber-400 hover:text-amber-300 font-mono mt-1 block font-bold transition-colors">
                  admin@servipromaenergy.com
                </a>
              </div>
            </div>

            <!-- Phone / WhatsApp -->
            <div class="p-4 rounded-lg bg-slate-900/70 border border-slate-800 flex items-start gap-3.5">
              <div class="w-8 h-8 rounded bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </div>
              <div class="text-xs font-sans">
                <div class="text-slate-400 font-mono text-[10px] uppercase tracking-wider font-semibold">Direct Phone & Engineering WhatsApp</div>
                <div class="flex items-center gap-3 mt-1">
                  <a href="tel:+584127251017" class="text-white hover:text-amber-400 font-mono font-bold transition-colors">
                    +58 412 725 1017
                  </a>
                  <span class="text-slate-600">·</span>
                  <a href="https://wa.me/584127251017" target="_blank" rel="noopener" class="text-amber-400 hover:underline font-mono text-[11px]">
                    WhatsApp Chat →
                  </a>
                </div>
              </div>
            </div>

            <!-- Tax ID -->
            <div class="p-4 rounded-lg bg-slate-900/70 border border-slate-800 flex items-center justify-between text-xs">
              <span class="text-slate-400 font-mono text-[10px] uppercase tracking-wider">Tax Registration Number</span>
              <span class="text-white font-mono font-bold">RIF: J-508883055</span>
            </div>
          </div>

          <!-- Technical SLA Commitments -->
          <div class="p-5 rounded-xl border border-slate-800 bg-slate-900/40 space-y-3 text-xs">
            <div class="text-amber-400 font-mono font-bold text-xs uppercase tracking-wider">
              Technical Service Commitments (SLA)
            </div>
            <ul class="space-y-2 text-slate-300">
              <li class="flex items-start gap-2">
                <span class="text-amber-400 font-bold shrink-0">■</span>
                <span><strong>Initial project evaluation:</strong> Technical feedback within 24 business hours.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-400 font-bold shrink-0">■</span>
                <span><strong>Outage & post-trip emergencies:</strong> Priority routing for COMTRADE extraction and diagnostics.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-400 font-bold shrink-0">■</span>
                <span><strong>Mutual NDA:</strong> Executed prior to exchanging single-line drawings or protection settings.</span>
              </li>
            </ul>
          </div>

        </div>

        <!-- Right: Structured Engineering Form -->
        <div class="lg:col-span-7">
          <div class="p-8 sm:p-10 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl relative">
            
            <div class="mb-8">
              <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block font-mono mb-2">Technical Inquiry</span>
              <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
                Project Evaluation & Quotation Request
              </h2>
              <p class="text-slate-400 text-xs mt-2 leading-relaxed">
                Provide installation or contingency details. A senior engineer will review the parameters to provide a preliminary technical assessment.
              </p>
            </div>

            <form id="contact-form-en" class="space-y-6">
              
              <!-- Contact Details -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="c-name-en" class="block text-xs font-mono font-medium text-slate-300 mb-2">Full Name *</label>
                  <input 
                    id="c-name-en"
                    name="name"
                    type="text" 
                    required 
                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
                    placeholder="Carlos Mendoza, P.E." 
                  />
                </div>
                <div>
                  <label for="c-company-en" class="block text-xs font-mono font-medium text-slate-300 mb-2">Company / Utility *</label>
                  <input 
                    id="c-company-en"
                    name="company"
                    type="text" 
                    required 
                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
                    placeholder="Utility / Transmission EPC / Industrial Plant" 
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="c-email-en" class="block text-xs font-mono font-medium text-slate-300 mb-2">Corporate Email *</label>
                  <input 
                    id="c-email-en"
                    name="email"
                    type="email" 
                    required 
                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
                    placeholder="cmendoza@company.com" 
                  />
                </div>
                <div>
                  <label for="c-phone-en" class="block text-xs font-mono font-medium text-slate-300 mb-2">Direct Phone Number *</label>
                  <input 
                    id="c-phone-en"
                    name="phone"
                    type="tel" 
                    required
                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors font-mono"
                    placeholder="+1 000 000 0000" 
                  />
                </div>
              </div>

              <!-- Technical Parameters -->
              <div class="p-4 sm:p-5 rounded-xl bg-slate-950/70 border border-slate-800/80 space-y-4">
                <div class="text-xs font-mono text-amber-400 font-bold uppercase tracking-wider">
                  Technical Facility Parameters
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="c-voltage-en" class="block text-xs font-mono text-slate-300 mb-1.5">Primary Voltage Level</label>
                    <select id="c-voltage-en" name="voltage" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500">
                      <option value="Extra-High Voltage (765 kV – 400 kV)">Extra-High Voltage (765 kV – 400 kV)</option>
                      <option value="High Voltage (230 kV – 115 kV)">High Voltage (230 kV – 115 kV)</option>
                      <option value="Subtransmission (69 kV – 34.5 kV)">Subtransmission (69 kV – 34.5 kV)</option>
                      <option value="Medium Voltage / Industrial (13.8 kV – 4.16 kV)">Medium Voltage / Industrial (13.8 kV – 4.16 kV)</option>
                      <option value="Multiple Voltages / Not Applicable">Multiple Voltages / Not Applicable</option>
                    </select>
                  </div>

                  <div>
                    <label for="c-facility-en" class="block text-xs font-mono text-slate-300 mb-1.5">Facility Type</label>
                    <select id="c-facility-en" name="facility" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500">
                      <option value="Transmission / Dispatch Substation">Transmission / Dispatch Substation</option>
                      <option value="Power Generation Plant (Thermal / Hydro)">Power Generation Plant (Thermal / Hydro)</option>
                      <option value="Refinery / Petrochemical / Upstream">Refinery / Petrochemical / Upstream</option>
                      <option value="Steel / Mining / Heavy Industrial Plant">Steel / Mining / Heavy Industrial Plant</option>
                      <option value="Other Industrial Sector">Other Industrial Sector</option>
                    </select>
                  </div>
                </div>

                <div>
                  <label for="c-service-en" class="block text-xs font-mono text-slate-300 mb-1.5">Required Service or Discipline *</label>
                  <select id="c-service-en" name="service" required class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500">
                    <option value="">Select scope...</option>
                    <option value="Electrical Protections & FAT/SAT Testing (Omicron)">Electrical Protections & FAT/SAT Testing (Omicron)</option>
                    <option value="Substation Automation (IEC 61850) & RTU Gateways (SICAM)">Substation Automation (IEC 61850) & RTU Gateways (SICAM)</option>
                    <option value="SLRP System Implementation (Remote COMTRADE Retrieval)">SLRP System Implementation (Remote COMTRADE Retrieval)</option>
                    <option value="Power System Studies: Coordination (TCC), Short-Circuit & Flow">Power System Studies: Coordination (TCC), Short-Circuit & Flow</option>
                    <option value="Post-Fault Root Cause & Trip Investigation">Post-Fault Root Cause & Trip Investigation</option>
                    <option value="Preventive / Corrective Maintenance Framework Contract">Preventive / Corrective Maintenance Framework Contract</option>
                  </select>
                </div>
              </div>

              <!-- Scope Description -->
              <div>
                <label for="c-details-en" class="block text-xs font-mono font-medium text-slate-300 mb-2">
                  Project Scope or Operational Issue Description *
                </label>
                <textarea 
                  id="c-details-en"
                  name="details"
                  required 
                  rows="4" 
                  class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
                  placeholder="Specify relay/RTU brands (Siemens, SEL, GE, ABB), number of bays, observed fault event, or tender specifications..."
                ></textarea>
              </div>

              <!-- Submit Buttons -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <button 
                  type="submit" 
                  class="w-full py-3.5 px-4 bg-amber-500 hover:bg-amber-400 text-slate-950 font-mono font-bold text-xs uppercase tracking-wider rounded-lg transition-all shadow-xl shadow-amber-500/20 active:scale-98 flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span>Send via Email</span>
                  <span class="font-bold">→</span>
                </button>
                <button 
                  type="button" 
                  id="contact-whatsapp-btn-en"
                  class="w-full py-3.5 px-4 border border-emerald-500/40 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 font-mono font-bold text-xs uppercase tracking-wider rounded-lg transition-all flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span>Send via WhatsApp</span>
                </button>
              </div>

              <div id="contact-feedback-en" class="hidden p-3.5 rounded-lg border border-emerald-500/40 bg-emerald-500/10 text-emerald-300 text-xs font-mono leading-relaxed" role="status" aria-live="polite"></div>

              <div class="text-xs text-slate-400 text-center font-mono">
                All technical data is handled under strict professional confidentiality.
              </div>

            </form>

          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Technical FAQ -->
  <section class="py-20 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block font-mono mb-2">FAQ</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Frequently Asked Engineering Questions</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <div class="p-6 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="text-base font-bold text-white">Do you perform FAT testing at client assembly facilities?</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Yes. Our engineers travel with certified secondary injection test sets (Omicron CMC 356, Ponovo) to panel builders' integration shops to protocolize factory acceptance testing prior to site dispatch.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="text-base font-bold text-white">How do you evaluate SLRP feasibility on our network?</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            We conduct an audit of your installed relay models and available WAN channels (fiber optics, OPGW, or radio links). If relays have serial or Ethernet ports, SLRP can be deployed without replacing existing IEDs.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="text-base font-bold text-white">Can you service bays without de-energizing the entire substation?</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            This is our core specialty. With over 35 years of combined experience across bulk substations for national utilities, we apply strict interlocking and trip isolation procedures to safely execute live interventions.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="text-base font-bold text-white">What is your mobilization timeframe for grid contingencies?</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            We maintain senior engineering staff in Caracas with immediate air or ground dispatch capability in under 12 hours nationwide, and planned rapid response mobilization for regional contracts under SLA terms.
          </p>
        </div>

      </div>
    </div>
  </section>

  <script>
    const formEn = document.getElementById('contact-form-en') as HTMLFormElement | null;
    const waBtnEn = document.getElementById('contact-whatsapp-btn-en');
    const feedbackEn = document.getElementById('contact-feedback-en');

    function buildPayloadEn() {
      const name = (document.getElementById('c-name-en') as HTMLInputElement)?.value.trim() || '';
      const company = (document.getElementById('c-company-en') as HTMLInputElement)?.value.trim() || '';
      const email = (document.getElementById('c-email-en') as HTMLInputElement)?.value.trim() || '';
      const phone = (document.getElementById('c-phone-en') as HTMLInputElement)?.value.trim() || '';
      const voltage = (document.getElementById('c-voltage-en') as HTMLSelectElement)?.value || '';
      const facility = (document.getElementById('c-facility-en') as HTMLSelectElement)?.value || '';
      const service = (document.getElementById('c-service-en') as HTMLSelectElement)?.value || '';
      const details = (document.getElementById('c-details-en') as HTMLTextAreaElement)?.value.trim() || '';

      const subject = `[Technical Assessment] ${service || 'General Inquiry'} - ${company || name}`;
      const body = [
        `Technical Assessment Request — Serviproma Energy`,
        `--------------------------------------------------`,
        `Name: ${name}`,
        `Company / Utility: ${company}`,
        `Email: ${email}`,
        `Phone: ${phone}`,
        `Voltage Level: ${voltage}`,
        `Facility Type: ${facility}`,
        `Discipline: ${service}`,
        ``,
        `Technical Scope / Details:`,
        details,
      ].join('\n');

      return { subject, body };
    }

    function showFeedbackEn(msg: string) {
      if (!feedbackEn) return;
      feedbackEn.textContent = msg;
      feedbackEn.classList.remove('hidden');
    }

    if (formEn) {
      formEn.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!formEn.reportValidity()) return;
        const { subject, body } = buildPayloadEn();
        window.location.href = `mailto:admin@servipromaenergy.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        showFeedbackEn('✓ Technical inquiry drafted in your email client for admin@servipromaenergy.com.');
      });
    }

    if (waBtnEn && formEn) {
      waBtnEn.addEventListener('click', () => {
        if (!formEn.reportValidity()) return;
        const { body } = buildPayloadEn();
        window.open(`https://wa.me/584127251017?text=${encodeURIComponent(body)}`, '_blank', 'noopener,noreferrer');
        showFeedbackEn('✓ Opening Engineering WhatsApp with your facility summary.');
      });
    }
  </script>
</Layout>
