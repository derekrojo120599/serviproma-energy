  <!-- Script del Slider Hero con Rotación Izquierda a Derecha -->
  <script>
    function setupHeroSlider() {
      const slides = document.querySelectorAll<HTMLElement>('.hero-slide');
      const dots = document.querySelectorAll<HTMLElement>('.slider-dot');
      const captionEl = document.getElementById('slider-caption');
      const counterEl = document.getElementById('slider-counter');
      
      if (!slides.length || slides.length <= 1) return;

      let currentIndex = 0;
      let isAnimating = false;
      const intervalTime = 5500;
      const animDuration = 1200;
      let timer: number | undefined;

      function updateUI(idx: number) {
        dots.forEach((dot, i) => {
          if (i === idx) {
            dot.className = 'slider-dot h-1.5 rounded-full transition-all duration-500 cursor-pointer w-8 bg-amber-400 shadow-sm shadow-amber-400/50';
          } else {
            dot.className = 'slider-dot h-1.5 rounded-full transition-all duration-500 cursor-pointer w-3 bg-slate-700 hover:bg-slate-500';
          }
        });

        if (counterEl) {
          counterEl.textContent = `0${idx + 1} / 0${slides.length}`;
        }

        if (captionEl) {
          const nextLabel = slides[idx].getAttribute('data-label') || '';
          captionEl.style.opacity = '0';
          setTimeout(() => {
            captionEl.textContent = nextLabel;
            captionEl.style.opacity = '1';
          }, 250);
        }
      }

      function slideTo(nextIndex: number) {
        if (isAnimating || nextIndex === currentIndex) return;
        isAnimating = true;

        const currentSlide = slides[currentIndex];
        const nextSlide = slides[nextIndex];

        nextSlide.style.transition = 'none';
        nextSlide.style.transform = 'translateX(-100%)';
        nextSlide.style.opacity = '0';
        nextSlide.style.zIndex = '2';
        currentSlide.style.zIndex = '1';

        void nextSlide.offsetHeight;

        const easing = 'cubic-bezier(0.25, 1, 0.5, 1)';
        currentSlide.style.transition = `transform ${animDuration}ms ${easing}, opacity ${animDuration}ms ease`;
        currentSlide.style.transform = 'translateX(100%)';
        currentSlide.style.opacity = '0';

        nextSlide.style.transition = `transform ${animDuration}ms ${easing}, opacity ${animDuration}ms ease`;
        nextSlide.style.transform = 'translateX(0%)';
        nextSlide.style.opacity = '1';

        updateUI(nextIndex);

        setTimeout(() => {
          currentSlide.style.transition = 'none';
          currentSlide.style.transform = 'translateX(-100%)';
          currentSlide.style.zIndex = '0';
          currentIndex = nextIndex;
          isAnimating = false;
        }, animDuration);
      }

      function nextSlide() {
        const next = (currentIndex + 1) % slides.length;
        slideTo(next);
      }

      function startAutoPlay() {
        stopAutoPlay();
        timer = window.setInterval(nextSlide, intervalTime);
      }

      function stopAutoPlay() {
        if (timer) {
          clearInterval(timer);
          timer = undefined;
        }
      }

      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          const target = e.currentTarget as HTMLElement;
          const targetIndex = parseInt(target.getAttribute('data-dot-index') || '0', 10);
          slideTo(targetIndex);
          startAutoPlay();
        });
      });

      startAutoPlay();

      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          stopAutoPlay();
        } else {
          startAutoPlay();
        }
      });
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', setupHeroSlider);
    } else {
      setupHeroSlider();
    }
  </script>

