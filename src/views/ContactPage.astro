---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const k = c.contact;
---
<Base lang={lang} page="contact">
  <PageHeader title={k.title} lead={k.lead} />
  <section class="section">
    <div class="wrap grid gap-12 lg:grid-cols-[1.5fr_1fr] lg:gap-20">
      <div class="border border-slate-800 bg-surface p-6 sm:p-9">
        <ContactForm lang={lang} variant="contact" />
      </div>
      <aside>
        <h2 class="text-xl">{k.directTitle}</h2>
        <ul class="mt-6 space-y-4 border-t border-slate-800 pt-6">
          <li><a class="break-all text-lg text-white hover:text-amber-400" href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a class="data text-lg text-white hover:text-amber-400" href={site.phoneHref}>{site.phone}</a></li>
          <li><a class="btn-secondary mt-2" href={site.whatsappHref} rel="noopener">{c.common.whatsapp}</a></li>
          {site.legal.address && <li class="text-slate-300">{site.legal.address}</li>}
          {site.legal.rif && <li class="text-slate-300">{c.common.footer.rif}: <span class="data">{site.legal.rif}</span></li>}
        </ul>
      </aside>
    </div>
  </section>
</Base>
