---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Serviproma Energy | Precisión Técnica en Sistemas de Potencia", 
  description = "Ingeniería, protecciones eléctricas, automatización y sistemas SCADA hasta 765 kV para el sector eléctrico, petrolero e industrial." 
} = Astro.props;
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-950 text-white font-['Public_Sans',sans-serif] selection:bg-amber-400 selection:text-slate-950 antialiased flex flex-col min-h-screen">
    <!-- Header / Navbar -->
    <header class="sticky top-0 z-50 bg-slate-950/85 backdrop-blur-md border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href="/" class="flex items-center group">
          <img 
            src="/images/logo_ambar.png" 
            alt="Serviproma Energy C.A." 
            class="h-11 w-auto object-contain group-hover:scale-105 transition-transform" 
          />
        </a>

        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
          <a href="/" class="hover:text-amber-400 transition-colors">Inicio</a>
          <a href="/nosotros" class="hover:text-amber-400 transition-colors">Empresa</a>
          <a href="/servicios" class="hover:text-amber-400 transition-colors">Servicios</a>
          <a href="/slrp" class="hover:text-amber-400 transition-colors flex items-center gap-1.5">
            <span>SLRP</span>
            <span class="px-1.5 py-0.5 text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded">Exclusivo</span>
          </a>
          <a href="/experiencia" class="hover:text-amber-400 transition-colors">Experiencia</a>
          <a href="/contacto" class="hover:text-amber-400 transition-colors">Contacto</a>
        </nav>

        <div class="flex items-center gap-4">
          <a 
            href="/contacto" 
            class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-xs uppercase font-bold tracking-wider rounded-lg bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 hover:from-amber-400 hover:to-amber-500 shadow-md shadow-amber-500/10 transition-all active:scale-95"
          >
            Cotizar Servicio
          </a>
          <button id="mobile-menu-btn" class="md:hidden p-2 text-slate-400 hover:text-white" aria-label="Abrir menú">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Menú móvil desplegable -->
      <div id="mobile-menu" class="hidden md:hidden border-b border-slate-800 bg-slate-900/95 px-4 pt-3 pb-6 space-y-3 text-base">
        <a href="/" class="block text-slate-300 hover:text-amber-400 py-1">Inicio</a>
        <a href="/nosotros" class="block text-slate-300 hover:text-amber-400 py-1">Empresa</a>
        <a href="/servicios" class="block text-slate-300 hover:text-amber-400 py-1">Servicios</a>
        <a href="/slrp" class="block text-slate-300 hover:text-amber-400 py-1">SLRP (Lectura Remota de Protecciones)</a>
        <a href="/experiencia" class="block text-slate-300 hover:text-amber-400 py-1">Experiencia</a>
        <a href="/contacto" class="block text-amber-400 font-semibold py-1">Contacto y Cotización</a>
      </div>
    </header>

    <!-- Contenido principal -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer Corporativo -->
    <footer class="bg-slate-900 border-t border-slate-800 pt-16 pb-12 text-slate-400 text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
        <div class="space-y-4 md:col-span-1">
          <a href="/" class="inline-block">
            <img 
              src="/images/logo_blanco.png" 
              alt="Serviproma Energy C.A." 
              class="h-10 w-auto object-contain opacity-95 hover:opacity-100 transition-opacity" 
            />
          </a>
          <p class="text-xs text-slate-400 leading-relaxed">
            Energía en servicio, con precisión técnica. Ingeniería, protecciones y SCADA en alta y extra alta tensión hasta 765 kV.
          </p>
          <div class="text-xs text-slate-500">
            RIF J-508883055
          </div>
        </div>

        <div>
          <h4 class="text-white font-semibold text-xs tracking-wider uppercase mb-4">Soluciones</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="/servicios#protecciones" class="hover:text-amber-400 transition-colors">Protecciones y Comisionamiento</a></li>
            <li><a href="/servicios#automatizacion" class="hover:text-amber-400 transition-colors">Automatización y SCADA (IEC 61850)</a></li>
            <li><a href="/slrp" class="hover:text-amber-400 transition-colors">Sistema SLRP</a></li>
            <li><a href="/servicios#estudios" class="hover:text-amber-400 transition-colors">Estudios de Potencia</a></li>
            <li><a href="/servicios#industria" class="hover:text-amber-400 transition-colors">Industria y Petróleo</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-semibold text-xs tracking-wider uppercase mb-4">Empresa</h4>
          <ul class="space-y-2 text-xs">
            <li><a href="/nosotros" class="hover:text-amber-400 transition-colors">Quiénes somos</a></li>
            <li><a href="/nosotros#alcance" class="hover:text-amber-400 transition-colors">Presencia en 6 países</a></li>
            <li><a href="/experiencia" class="hover:text-amber-400 transition-colors">Casos de Éxito</a></li>
            <li><a href="/contacto" class="hover:text-amber-400 transition-colors">Sede Caracas</a></li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-semibold text-xs tracking-wider uppercase mb-4">Contacto Directo</h4>
          <ul class="space-y-3 text-xs">
            <li class="flex items-start gap-2">
              <span class="text-amber-400">📍</span>
              <span>Av. Las Mercedes, Edif. EXPO 3A, Of. 1-A, Caracas, Venezuela</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amber-400">✉️</span>
              <a href="mailto:admin@servipromaenergy.com" class="hover:text-amber-400">admin@servipromaenergy.com</a>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amber-400">📞</span>
              <a href="tel:+584127251017" class="hover:text-amber-400">+58 412 725 1017</a>
            </li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
        <p>© {new Date().getFullYear()} Serviproma Energy C.A. Todos los derechos reservados.</p>
        <p class="text-slate-600">Alta y Extra Alta Tensión · 13.8 kV a 765 kV</p>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
