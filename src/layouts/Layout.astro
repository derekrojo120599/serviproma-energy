---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'es' | 'en';
  currentPath?: string;
}

const { 
  lang = 'es',
  currentPath = '/',
  title = lang === 'es' 
    ? "Serviproma Energy | Precisión Técnica en Sistemas de Potencia" 
    : "Serviproma Energy | Precision Engineering in Power Systems", 
  description = lang === 'es'
    ? "Ingeniería, protecciones eléctricas, automatización y sistemas SCADA hasta 765 kV para el sector eléctrico, petrolero e industrial."
    : "Protection, automation, control, and SCADA engineering up to 765 kV for the power, oil, and industrial sectors."
} = Astro.props;

const nav = {
  es: [
    { href: '/', label: 'Inicio' },
    { href: '/nosotros', label: 'Empresa' },
    { href: '/servicios', label: 'Servicios' },
    { href: '/slrp', label: 'SLRP', badge: 'Exclusivo' },
    { href: '/experiencia', label: 'Experiencia' },
    { href: '/contacto', label: 'Contacto' },
  ],
  en: [
    { href: '/en', label: 'Home' },
    { href: '/en/about', label: 'Company' },
    { href: '/en/services', label: 'Services' },
    { href: '/en/slrp', label: 'SLRP', badge: 'Exclusive' },
    { href: '/en/experience', label: 'Experience' },
    { href: '/en/contact', label: 'Contact' },
  ],
};

const ctaLabel = lang === 'es' ? 'Cotizar Servicio' : 'Request Assessment';
const ctaHref = lang === 'es' ? '/contacto' : '/en/contact';

const targetLang = lang === 'es' ? 'en' : 'es';
const targetHref = lang === 'es' ? (
  currentPath === '/nosotros' ? '/en/about' :
  currentPath === '/servicios' ? '/en/services' :
  currentPath === '/slrp' ? '/en/slrp' :
  currentPath === '/experiencia' ? '/en/experience' :
  currentPath === '/contacto' ? '/en/contact' : '/en'
) : (
  currentPath === '/en/about' ? '/nosotros' :
  currentPath === '/en/services' ? '/servicios' :
  currentPath === '/en/slrp' ? '/slrp' :
  currentPath === '/en/experience' ? '/experiencia' :
  currentPath === '/en/contact' ? '/contacto' : '/'
);
---

<!doctype html>
<html lang={lang} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Public+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  </head>
  <body class="bg-slate-950 text-white font-['Public_Sans',sans-serif] selection:bg-amber-400 selection:text-slate-950 antialiased flex flex-col min-h-screen">
    <!-- Header / Navbar -->
    <header class="sticky top-0 z-50 bg-slate-950/85 backdrop-blur-md border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        <a href={lang === 'es' ? '/' : '/en'} class="flex items-center group">
          <img 
            src="/images/iso_blanco.png" 
            alt="Serviproma Energy C.A." 
            class="h-11 sm:h-12 w-auto object-contain group-hover:scale-105 transition-transform" 
          />
        </a>

        <!-- Desktop Navigation -->
        <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
          {nav[lang].map((item) => (
            <a 
              href={item.href} 
              class={`transition-colors flex items-center gap-1.5 ${currentPath === item.href ? 'text-amber-400 font-semibold' : 'hover:text-amber-400'}`}
            >
              <span>{item.label}</span>
              {item.badge && (
                <span class="px-1.5 py-0.5 text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30 rounded font-mono">
                  {item.badge}
                </span>
              )}
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-3">
          <!-- Language Selector -->
          <a 
            href={targetHref} 
            class="px-2.5 py-1.5 text-xs font-mono font-semibold text-slate-300 hover:text-amber-400 border border-slate-800 hover:border-amber-500/40 bg-slate-900/60 rounded transition-all flex items-center gap-1.5"
            title={lang === 'es' ? 'Switch to English' : 'Cambiar a Español'}
          >
            <span>{lang === 'es' ? 'EN' : 'ES'}</span>
            <span class="text-slate-500 text-[10px]">⇄</span>
          </a>

          <a 
            href={ctaHref} 
            class="hidden sm:inline-flex items-center justify-center px-4 py-2 text-xs uppercase font-bold tracking-wider rounded-lg bg-gradient-to-r from-amber-500 to-amber-600 text-slate-950 hover:from-amber-400 hover:to-amber-500 shadow-md shadow-amber-500/10 transition-all active:scale-95"
          >
            {ctaLabel}
          </a>
          <button id="mobile-menu-btn" class="md:hidden p-2 text-slate-400 hover:text-white" aria-label="Abrir menú">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
      </div>

      <!-- Menú móvil desplegable -->
      <div id="mobile-menu" class="hidden md:hidden border-b border-slate-800 bg-slate-900/95 px-4 pt-3 pb-6 space-y-3 text-base">
        {nav[lang].map((item) => (
          <a href={item.href} class="block text-slate-300 hover:text-amber-400 py-1">
            {item.label}
          </a>
        ))}
        <div class="pt-2 border-t border-slate-800 flex items-center justify-between">
          <a href={targetHref} class="text-xs font-mono text-amber-400">
            {lang === 'es' ? 'Switch to English version (EN)' : 'Cambiar a versión en Español (ES)'}
          </a>
        </div>
      </div>
    </header>

    <!-- Contenido principal -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- Footer Corporativo -->
    <footer class="bg-slate-900 border-t border-slate-800 pt-16 pb-12 text-slate-400 text-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
        <div class="space-y-4 md:col-span-1">
          <a href={lang === 'es' ? '/' : '/en'} class="inline-block">
            <img 
              src="/images/logo_blanco.png" 
              alt="Serviproma Energy C.A." 
              class="h-14 sm:h-16 w-auto object-contain opacity-95 hover:opacity-100 transition-opacity" 
            />
          </a>
          <p class="text-xs text-slate-400 leading-relaxed">
            {lang === 'es' 
              ? 'Energía en servicio, con precisión técnica. Ingeniería, protecciones y SCADA en alta y extra alta tensión hasta 765 kV.'
              : 'Power in service, with technical precision. Protection, automation, control, and SCADA engineering up to 765 kV.'
            }
          </p>
          <div class="text-xs text-slate-500 font-mono">
            RIF J-508883055
          </div>
        </div>

        <div>
          <h4 class="text-white font-semibold text-xs tracking-wider uppercase mb-4 font-mono">
            {lang === 'es' ? 'Soluciones' : 'Solutions'}
          </h4>
          <ul class="space-y-2 text-xs">
            <li>
              <a href={lang === 'es' ? '/servicios#protecciones' : '/en/services#protections'} class="hover:text-amber-400 transition-colors">
                {lang === 'es' ? 'Protecciones y Comisionamiento' : 'Protection & Commissioning'}
              </a>
            </li>
            <li>
              <a href={lang === 'es' ? '/servicios#automatizacion' : '/en/services#automation'} class="hover:text-amber-400 transition-colors">
                {lang === 'es' ? 'Automatización y SCADA (IEC 61850)' : 'Automation & SCADA (IEC 61850)'}
              </a>
            </li>
            <li>
              <a href={lang === 'es' ? '/slrp' : '/en/slrp'} class="hover:text-amber-400 transition-colors">
                {lang === 'es' ? 'Sistema SLRP' : 'SLRP Technology'}
              </a>
            </li>
            <li>
              <a href={lang === 'es' ? '/servicios#estudios' : '/en/services#studies'} class="hover:text-amber-400 transition-colors">
                {lang === 'es' ? 'Estudios Eléctricos de Potencia' : 'Power System Studies'}
              </a>
            </li>
            <li>
              <a href={lang === 'es' ? '/servicios#industria' : '/en/services#industry'} class="hover:text-amber-400 transition-colors">
                {lang === 'es' ? 'Industria y Petróleo' : 'Industry & Oil'}
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-semibold text-xs tracking-wider uppercase mb-4 font-mono">
            {lang === 'es' ? 'Empresa' : 'Company'}
          </h4>
          <ul class="space-y-2 text-xs">
            <li>
              <a href={lang === 'es' ? '/nosotros' : '/en/about'} class="hover:text-amber-400 transition-colors">
                {lang === 'es' ? 'Quiénes somos' : 'About Us'}
              </a>
            </li>
            <li>
              <a href={lang === 'es' ? '/nosotros#alcance' : '/en/about#reach'} class="hover:text-amber-400 transition-colors">
                {lang === 'es' ? 'Presencia en 6 países' : 'Presence in 6 Countries'}
              </a>
            </li>
            <li>
              <a href={lang === 'es' ? '/experiencia' : '/en/experience'} class="hover:text-amber-400 transition-colors">
                {lang === 'es' ? 'Casos de Éxito' : 'Proven Track Record'}
              </a>
            </li>
            <li>
              <a href={lang === 'es' ? '/contacto' : '/en/contact'} class="hover:text-amber-400 transition-colors">
                {lang === 'es' ? 'Sede Central Caracas' : 'Caracas Headquarters'}
              </a>
            </li>
          </ul>
        </div>

        <div>
          <h4 class="text-white font-semibold text-xs tracking-wider uppercase mb-4 font-mono">
            {lang === 'es' ? 'Contacto Directo' : 'Direct Contact'}
          </h4>
          <ul class="space-y-3 text-xs">
            <li class="flex items-start gap-2">
              <span class="text-amber-400">📍</span>
              <span>Av. Las Mercedes, Edif. EXPO 3A, Of. 1-A, Caracas, Venezuela</span>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amber-400">✉️</span>
              <a href="mailto:admin@servipromaenergy.com" class="hover:text-amber-400">admin@servipromaenergy.com</a>
            </li>
            <li class="flex items-center gap-2">
              <span class="text-amber-400">📞</span>
              <a href="tel:+584127251017" class="hover:text-amber-400">+58 412 725 1017</a>
            </li>
          </ul>
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
        <p>© {new Date().getFullYear()} Serviproma Energy C.A. {lang === 'es' ? 'Todos los derechos reservados.' : 'All rights reserved.'}</p>
        <p class="text-slate-600 font-mono">Alta y Extra Alta Tensión · 13.8 kV a 765 kV</p>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn && menu) {
        btn.addEventListener('click', () => {
          menu.classList.toggle('hidden');
        });
      }
    </script>
  </body>
</html>
