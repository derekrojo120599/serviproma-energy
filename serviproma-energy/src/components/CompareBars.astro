---
interface Side { label: string; time: string; text: string }
interface Props { without: Side; with: Side }
const { without, with: withSlrp } = Astro.props;
---
<div class="grid gap-10">
  <div>
    <div class="flex items-baseline justify-between gap-4">
      <h3 class="text-lg font-semibold text-slate-200">{without.label}</h3>
      <p class="data m-0 text-2xl text-white">{without.time}</p>
    </div>
    <div class="mt-3 flex h-5 items-stretch" aria-hidden="true">
      <div class="w-[92%] bg-slate-600"></div>
      <div class="w-[3%] -skew-x-[30deg] bg-slate-950"></div>
      <div class="w-[5%] bg-slate-600"></div>
    </div>
    <p class="mt-3 text-[0.95rem] text-slate-400">{without.text}</p>
  </div>
  <div>
    <div class="flex items-baseline justify-between gap-4">
      <h3 class="text-lg font-semibold text-amber-400">{withSlrp.label}</h3>
      <p class="data m-0 text-2xl text-amber-400">{withSlrp.time}</p>
    </div>
    <div class="mt-3 flex h-5" aria-hidden="true">
      <div class="w-[2.5%] min-w-3 bg-amber-400"></div>
    </div>
    <p class="mt-3 text-[0.95rem] text-slate-300">{withSlrp.text}</p>
  </div>
</div>
