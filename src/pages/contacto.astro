---
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="Contacto y Evaluación Técnica | Serviproma Energy C.A." 
  description="Canal directo con ingenieros especialistas en sistemas de potencia, protecciones eléctricas, comisionamiento FAT/SAT, SCADA y SLRP."
  lang="es" 
  currentPath="/contacto"
>
  <!-- Hero Contacto -->
  <section class="relative py-14 sm:py-24 border-b border-slate-800 bg-slate-950 overflow-hidden">
    <div class="absolute inset-0 z-0 pointer-events-none">
      <img 
        src="/images/benchmarks/eda-substation-night.jpg" 
        alt="Líneas de transmisión e infraestructura de subestaciones" 
        class="w-full h-full object-cover opacity-20"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-950/80 via-slate-950/95 to-slate-950"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center max-w-3xl relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded bg-amber-500/10 border border-amber-500/30 text-amber-400 text-xs font-mono font-semibold tracking-wider uppercase mb-4">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
        <span>Canal Directo de Ingeniería de Potencia</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        Evaluación Técnica de Subestaciones y Redes
      </h1>
      <p class="mt-4 text-slate-300 text-base leading-relaxed">
        Comuníquese directamente con nuestros ingenieros especialistas para cotizar comisionamientos FAT/SAT, integración SCADA, viabilidad SLRP o peritajes forenses post-falla.
      </p>
    </div>
  </section>

  <!-- Sección Principal: Canales Corporativos + Formulario de Ingeniería -->
  <section class="py-14 sm:py-24 bg-slate-950 border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start">
        
        <!-- Columna Izquierda: Información Corporativa y Compromisos de Servicio -->
        <div class="lg:col-span-5 space-y-6">
          
          <!-- Tarjeta de Sede y Despliegue -->
          <div class="rounded-xl bg-slate-900 border border-slate-800 overflow-hidden shadow-2xl">
            <div class="h-44 overflow-hidden relative">
              <img 
                src="/images/benchmarks/pace-hero-equipo.webp" 
                alt="Ingenieros de campo coordinando soporte técnico en subestación" 
                class="w-full h-full object-cover"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded bg-slate-950/80 border border-amber-500/30 text-[10px] font-mono text-amber-400 font-bold uppercase tracking-wider">
                Despliegue Nacional & Regional
              </span>
            </div>
            <div class="p-6">
              <h3 class="text-lg font-bold text-white mb-2 tracking-tight">Sede Principal y Base Operativa</h3>
              <p class="text-xs text-slate-300 leading-relaxed">
                Base central en Caracas con capacidad de movilización inmediata a subestaciones y complejos industriales en toda Venezuela, Chile y países de la región.
              </p>
            </div>
          </div>

          <!-- Canales Directos -->
          <div class="space-y-3 font-mono">
            <!-- Ubicación -->
            <div class="p-4 rounded-lg bg-slate-900/70 border border-slate-800 flex items-start gap-3.5">
              <div class="w-8 h-8 rounded bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path></svg>
              </div>
              <div class="text-xs font-sans">
                <div class="text-slate-400 font-mono text-[10px] uppercase tracking-wider font-semibold">Dirección Fiscal y Operativa</div>
                <div class="text-slate-200 mt-1 font-medium leading-relaxed">Av. Las Mercedes, Edif. EXPO 3A, Of. 1-A, Caracas, Venezuela</div>
              </div>
            </div>

            <!-- Email -->
            <div class="p-4 rounded-lg bg-slate-900/70 border border-slate-800 flex items-start gap-3.5">
              <div class="w-8 h-8 rounded bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path></svg>
              </div>
              <div class="text-xs font-sans">
                <div class="text-slate-400 font-mono text-[10px] uppercase tracking-wider font-semibold">Correo de Licitaciones y Proyectos</div>
                <a href="mailto:admin@servipromaenergy.com" class="text-amber-400 hover:text-amber-300 font-mono mt-1 block font-bold transition-colors">
                  admin@servipromaenergy.com
                </a>
              </div>
            </div>

            <!-- Teléfono / WhatsApp -->
            <div class="p-4 rounded-lg bg-slate-900/70 border border-slate-800 flex items-start gap-3.5">
              <div class="w-8 h-8 rounded bg-amber-500/10 text-amber-400 flex items-center justify-center shrink-0 mt-0.5">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              </div>
              <div class="text-xs font-sans">
                <div class="text-slate-400 font-mono text-[10px] uppercase tracking-wider font-semibold">Atención Telefónica y WhatsApp Técnico</div>
                <div class="flex items-center gap-3 mt-1">
                  <a href="tel:+584127251017" class="text-white hover:text-amber-400 font-mono font-bold transition-colors">
                    +58 412 725 1017
                  </a>
                  <span class="text-slate-600">·</span>
                  <a href="https://wa.me/584127251017" target="_blank" rel="noopener" class="text-amber-400 hover:underline font-mono text-[11px]">
                    Mensaje WhatsApp →
                  </a>
                </div>
              </div>
            </div>

            <!-- RIF y Datos Fiscales -->
            <div class="p-4 rounded-lg bg-slate-900/70 border border-slate-800 flex items-center justify-between text-xs">
              <span class="text-slate-400 font-mono text-[10px] uppercase tracking-wider">Registro de Información Fiscal</span>
              <span class="text-white font-mono font-bold">RIF: J-508883055</span>
            </div>
          </div>

          <!-- Protocolo de Respuesta Técnica (SLA) -->
          <div class="p-5 rounded-xl border border-slate-800 bg-slate-900/40 space-y-3 text-xs">
            <div class="text-amber-400 font-mono font-bold text-xs uppercase tracking-wider">
              Compromisos de Atención Técnica (SLA)
            </div>
            <ul class="space-y-2 text-slate-300">
              <li class="flex items-start gap-2">
                <span class="text-amber-400 font-bold shrink-0">■</span>
                <span><strong>Evaluación inicial de proyectos:</strong> Respuesta técnica en menos de 24 horas hábiles.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-400 font-bold shrink-0">■</span>
                <span><strong>Contingencias y análisis post-falla:</strong> Canal prioritario para despacho y extracción COMTRADE.</span>
              </li>
              <li class="flex items-start gap-2">
                <span class="text-amber-400 font-bold shrink-0">■</span>
                <span><strong>Acuerdo de Confidencialidad (NDA):</strong> Disponible antes del intercambio de diagramas unifilares o estudios.</span>
              </li>
            </ul>
          </div>

        </div>

        <!-- Columna Derecha: Formulario Estructurado de Ingeniería -->
        <div class="lg:col-span-7">
          <div class="p-8 sm:p-10 rounded-2xl bg-slate-900 border border-slate-800 shadow-2xl relative">
            
            <div class="mb-8">
              <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block font-mono mb-2">Formulario Técnico</span>
              <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
                Solicitud de Evaluación y Cotización
              </h2>
              <p class="text-slate-400 text-xs mt-2 leading-relaxed">
                Indique los detalles de su instalación o contingencia. Un ingeniero senior revisará la información para emitir un primer criterio de viabilidad.
              </p>
            </div>

            <form id="contact-form" class="space-y-6">
              
              <!-- Datos de Contacto -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="c-name" class="block text-xs font-mono font-medium text-slate-300 mb-2">Nombre y Apellido *</label>
                  <input 
                    id="c-name"
                    name="name"
                    type="text" 
                    required 
                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
                    placeholder="Ing. Carlos Mendoza" 
                  />
                </div>
                <div>
                  <label for="c-company" class="block text-xs font-mono font-medium text-slate-300 mb-2">Empresa u Organización *</label>
                  <input 
                    id="c-company"
                    name="company"
                    type="text" 
                    required 
                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
                    placeholder="CORPOELEC / Transelec / Refinería" 
                  />
                </div>
              </div>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                <div>
                  <label for="c-email" class="block text-xs font-mono font-medium text-slate-300 mb-2">Correo Corporativo *</label>
                  <input 
                    id="c-email"
                    name="email"
                    type="email" 
                    required 
                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
                    placeholder="cmendoza@empresa.com" 
                  />
                </div>
                <div>
                  <label for="c-phone" class="block text-xs font-mono font-medium text-slate-300 mb-2">Teléfono de Contacto Directo *</label>
                  <input 
                    id="c-phone"
                    name="phone"
                    type="tel" 
                    required
                    class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors font-mono"
                    placeholder="+58 412 000 0000" 
                  />
                </div>
              </div>

              <!-- Parámetros Técnicos de la Instalación -->
              <div class="p-4 sm:p-5 rounded-xl bg-slate-950/70 border border-slate-800/80 space-y-4">
                <div class="text-xs font-mono text-amber-400 font-bold uppercase tracking-wider">
                  Parámetros Técnicos de la Instalación
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="c-voltage" class="block text-xs font-mono text-slate-300 mb-1.5">Nivel de Tensión Principal</label>
                    <select id="c-voltage" name="voltage" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500">
                      <option value="Extra Alta Tensión (765 kV – 400 kV)">Extra Alta Tensión (765 kV – 400 kV)</option>
                      <option value="Alta Tensión (230 kV – 115 kV)">Alta Tensión (230 kV – 115 kV)</option>
                      <option value="Subtransmisión (69 kV – 34.5 kV)">Subtransmisión (69 kV – 34.5 kV)</option>
                      <option value="Media Tensión / Planta (13.8 kV – 4.16 kV)">Media Tensión / Planta (13.8 kV – 4.16 kV)</option>
                      <option value="Múltiples tensiones / No aplica">Múltiples tensiones / No aplica</option>
                    </select>
                  </div>

                  <div>
                    <label for="c-facility" class="block text-xs font-mono text-slate-300 mb-1.5">Tipo de Instalación</label>
                    <select id="c-facility" name="facility" class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500">
                      <option value="Subestación de Transmisión / Despacho">Subestación de Transmisión / Despacho</option>
                      <option value="Central de Generación (Térmica / Hidro)">Central de Generación (Térmica / Hidro)</option>
                      <option value="Refinería / Complejo Petroquímico / Upstream">Refinería / Complejo Petroquímico / Upstream</option>
                      <option value="Siderúrgica / Minería / Planta Pesada">Siderúrgica / Minería / Planta Pesada</option>
                      <option value="Otro sector industrial">Otro sector industrial</option>
                    </select>
                  </div>
                </div>

                <div>
                  <label for="c-service" class="block text-xs font-mono text-slate-300 mb-1.5">Servicio o Especialidad Solicitada *</label>
                  <select id="c-service" name="service" required class="w-full bg-slate-900 border border-slate-800 rounded-lg px-3.5 py-2.5 text-xs text-white focus:outline-none focus:border-amber-500">
                    <option value="">Seleccione el alcance requerido...</option>
                    <option value="Protecciones Eléctricas y Pruebas FAT/SAT (Omicron)">Protecciones Eléctricas y Pruebas FAT/SAT (Omicron)</option>
                    <option value="Automatización SAS (IEC 61850) y Gateways RTU (SICAM)">Automatización SAS (IEC 61850) y Gateways RTU (SICAM)</option>
                    <option value="Implementación de Sistema SLRP (Lectura Remota COMTRADE)">Implementación de Sistema SLRP (Lectura Remota COMTRADE)</option>
                    <option value="Estudios Eléctricos: Coordinación TCC, Cortocircuito y Flujo">Estudios Eléctricos: Coordinación TCC, Cortocircuito y Flujo</option>
                    <option value="Análisis Pericial Post-Falla / Disparo Indebido">Análisis Pericial Post-Falla / Disparo Indebido</option>
                    <option value="Contrato de Mantenimiento Preventivo / Correctivo">Contrato de Mantenimiento Preventivo / Correctivo</option>
                  </select>
                </div>
              </div>

              <!-- Descripción Libre -->
              <div>
                <label for="c-details" class="block text-xs font-mono font-medium text-slate-300 mb-2">
                  Descripción del Problema o Alcance del Proyecto *
                </label>
                <textarea 
                  id="c-details"
                  name="details"
                  required 
                  rows="4" 
                  class="w-full bg-slate-950 border border-slate-800 rounded-lg px-4 py-3 text-sm text-white focus:outline-none focus:border-amber-500 transition-colors"
                  placeholder="Especifique marcas de relés o RTUs instalados (Siemens, SEL, GE, ABB), cantidad de bahías, falla registrada o requerimientos de licitación..."
                ></textarea>
              </div>

              <!-- Botones de Envío Directo -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <button 
                  type="submit" 
                  data-channel="email"
                  class="w-full py-3.5 px-4 bg-amber-500 hover:bg-amber-400 text-slate-950 font-mono font-bold text-xs uppercase tracking-wider rounded-lg transition-all shadow-xl shadow-amber-500/20 active:scale-98 flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span>Enviar por Correo</span>
                  <span class="font-bold">→</span>
                </button>
                <button 
                  type="button"
                  id="contact-whatsapp-btn"
                  class="w-full py-3.5 px-4 border border-emerald-500/40 bg-emerald-500/10 hover:bg-emerald-500/20 text-emerald-300 font-mono font-bold text-xs uppercase tracking-wider rounded-lg transition-all flex items-center justify-center gap-2 cursor-pointer"
                >
                  <span>Enviar por WhatsApp</span>
                </button>
              </div>

              <div id="contact-feedback" class="hidden p-3.5 rounded-lg border border-emerald-500/40 bg-emerald-500/10 text-emerald-300 text-xs font-mono leading-relaxed" role="status" aria-live="polite"></div>

              <div class="text-xs text-slate-400 text-center font-mono">
                Información protegida bajo estricta confidencialidad técnica profesional.
              </div>

            </form>

          </div>
        </div>

      </div>

    </div>
  </section>

  <!-- Preguntas Frecuentes Técnicas (FAQ de Ingeniería) -->
  <section class="py-20 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-12">
        <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block font-mono mb-2">Resolución de Dudas</span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">Preguntas Frecuentes de Contratación</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        
        <div class="p-6 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="text-base font-bold text-white">¿Realizan pruebas FAT en los talleres o fábrica del cliente?</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Sí. Nuestros especialistas se trasladan con maletas de inyección secundaria certificadas (Omicron CMC 356, Ponovo) a plantas de integración o talleres de tableristas para protocolizar las pruebas de aceptación antes del despacho a obra.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="text-base font-bold text-white">¿Cómo se evalúa la viabilidad de la solución SLRP en mi red?</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Efectuamos un levantamiento del parque de relés instalado y los canales WAN disponibles (fibra óptica, OPGW o radioenlace). Si los IEDs cuentan con puerto serial o Ethernet, el SLRP puede implementarse sin necesidad de reemplazar los relés existentes.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="text-base font-bold text-white">¿Pueden intervenir bahías sin desenergizar toda la subestación?</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Es nuestra especialidad central. Con más de 35 años de experiencia acumulada en subestaciones troncales de CORPOELEC y Transelec, aplicamos procedimientos de enclavamiento y aislamiento de disparo seguros para intervenir en caliente sin riesgos de disparos intempestivos.
          </p>
        </div>

        <div class="p-6 rounded-xl bg-slate-900/60 border border-slate-800 space-y-2">
          <h3 class="text-base font-bold text-white">¿Cuál es el tiempo de movilización ante emergencias o disparos graves?</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Contamos con personal senior en Caracas y capacidad de despliegue aéreo o terrestre en menos de 12 horas en territorio venezolano, y coordinación de cuadrillas para contratos marco en el exterior en plazos acordados en el SLA.
          </p>
        </div>

      </div>
    </div>
  </section>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const waBtn = document.getElementById('contact-whatsapp-btn');
    const feedback = document.getElementById('contact-feedback');

    function buildPayload() {
      const name = (document.getElementById('c-name') as HTMLInputElement)?.value.trim() || '';
      const company = (document.getElementById('c-company') as HTMLInputElement)?.value.trim() || '';
      const email = (document.getElementById('c-email') as HTMLInputElement)?.value.trim() || '';
      const phone = (document.getElementById('c-phone') as HTMLInputElement)?.value.trim() || '';
      const voltage = (document.getElementById('c-voltage') as HTMLSelectElement)?.value || '';
      const facility = (document.getElementById('c-facility') as HTMLSelectElement)?.value || '';
      const service = (document.getElementById('c-service') as HTMLSelectElement)?.value || '';
      const details = (document.getElementById('c-details') as HTMLTextAreaElement)?.value.trim() || '';

      const subject = `[Evaluación Técnica] ${service || 'Consulta General'} - ${company || name}`;
      const body = [
        `Solicitud de Evaluación Técnica — Serviproma Energy`,
        `--------------------------------------------------`,
        `Nombre: ${name}`,
        `Empresa / Organización: ${company}`,
        `Correo: ${email}`,
        `Teléfono: ${phone}`,
        `Nivel de Tensión: ${voltage}`,
        `Tipo de Instalación: ${facility}`,
        `Especialidad: ${service}`,
        ``,
        `Descripción técnica:`,
        details,
      ].join('\n');

      return { subject, body };
    }

    function showFeedback(msg: string) {
      if (!feedback) return;
      feedback.textContent = msg;
      feedback.classList.remove('hidden');
    }

    if (form) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        if (!form.reportValidity()) return;
        const { subject, body } = buildPayload();
        window.location.href = `mailto:admin@servipromaenergy.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
        showFeedback('✓ Solicitud preparada en su cliente de correo hacia admin@servipromaenergy.com.');
      });
    }

    if (waBtn && form) {
      waBtn.addEventListener('click', () => {
        if (!form.reportValidity()) return;
        const { body } = buildPayload();
        window.open(`https://wa.me/584127251017?text=${encodeURIComponent(body)}`, '_blank', 'noopener,noreferrer');
        showFeedback('✓ Abriendo WhatsApp Técnico con el resumen de su instalación.');
      });
    }
  </script>
</Layout>
