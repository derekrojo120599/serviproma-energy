---
// Isotipo oficial de Serviproma Energy C.A. (iso_ambar.png)
interface Props { class?: string }
const { class: cls = '' } = Astro.props;
---
<span class:list={['inline-flex items-center gap-3', cls]}>
  <img 
    src="/images/iso_ambar.png" 
    alt="Serviproma Energy" 
    class="h-9 w-auto object-contain" 
  />
  <span class="leading-none">
    <span class="block text-[1.1rem] font-bold tracking-tight text-white">Serviproma</span>
    <span class="block text-[0.75rem] font-semibold text-amber-400 uppercase tracking-widest mt-1">Energy C.A.</span>
  </span>
</span>
