---
import { site } from '../config/site';
import { t, type Lang } from '../i18n';

interface Props { lang: Lang; variant?: 'contact' | 'slrp' }
const { lang, variant = 'contact' } = Astro.props;
const c = t(lang);
const f = c.form;
const id = (n: string) => `${variant}-${n}`;
const field = 'mt-2 block w-full border border-slate-700 bg-slate-900 px-4 py-3 text-slate-100 placeholder:text-slate-500 focus:border-amber-400';
const label = 'block text-[0.95rem] font-medium text-slate-200';
---
<form
  data-contact
  data-endpoint={site.formEndpoint}
  data-email={site.email}
  data-sending={f.sending}
  data-sent={f.sent}
  data-error={f.error}
  data-mailto={f.mailtoFallback}
  data-variant={variant}
  method="post"
  class="grid gap-6"
>
  <input type="hidden" name="subject" value={variant === 'slrp' ? 'Web: consulta de viabilidad SLRP' : 'Web: solicitud de evaluación técnica'} />
  <input type="hidden" name="lang" value={lang} />
  <p class="absolute -left-[9999px]" aria-hidden="true">
    <label>No completar <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" /></label>
  </p>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <label class={label} for={id('name')}>{f.name} <span aria-hidden="true" class="text-amber-400">*</span></label>
      <input class={field} id={id('name')} name="name" type="text" autocomplete="name" required />
    </div>
    <div>
      <label class={label} for={id('company')}>{f.company} <span aria-hidden="true" class="text-amber-400">*</span></label>
      <input class={field} id={id('company')} name="company" type="text" autocomplete="organization" required />
    </div>
    <div>
      <label class={label} for={id('role')}>{f.role}</label>
      <input class={field} id={id('role')} name="role" type="text" autocomplete="organization-title" />
    </div>
    <div>
      <label class={label} for={id('email')}>{f.email} <span aria-hidden="true" class="text-amber-400">*</span></label>
      <input class={field} id={id('email')} name="email" type="email" autocomplete="email" required />
    </div>
    <div class="sm:col-span-2">
      <label class={label} for={id('phone')}>{f.phone}</label>
      <input class={field} id={id('phone')} name="phone" type="tel" autocomplete="tel" />
    </div>
  </div>

  {variant === 'contact' ? (
    <div>
      <label class={label} for={id('area')}>{c.contact.areaLabel} <span aria-hidden="true" class="text-amber-400">*</span></label>
      <select class={field} id={id('area')} name="area" required>
        {c.contact.areas.map((a) => <option value={a}>{a}</option>)}
      </select>
    </div>
  ) : (
    <>
      <input type="hidden" name="area" value="SLRP" />
      <div class="grid gap-6 sm:grid-cols-[2fr_1fr]">
        <div>
          <label class={label} for={id('relays')}>{f.relays} <span aria-hidden="true" class="text-amber-400">*</span></label>
          <input class={field} id={id('relays')} name="relays" type="text" placeholder={f.relaysPlaceholder} required />
        </div>
        <div>
          <label class={label} for={id('subs')}>{f.substations}</label>
          <input class={`${field} data`} id={id('subs')} name="substations" type="number" min="1" inputmode="numeric" />
        </div>
      </div>
    </>
  )}

  <div>
    <label class={label} for={id('message')}>{f.message} <span aria-hidden="true" class="text-amber-400">*</span></label>
    <textarea class={field} id={id('message')} name="message" rows="5" placeholder={f.messagePlaceholder} required></textarea>
  </div>

  <div class="flex flex-wrap items-center gap-5">
    <button type="submit" class="bg-amber-400 px-7 py-3.5 text-base font-semibold text-slate-950 transition-colors hover:bg-amber-300 disabled:opacity-60">
      {variant === 'slrp' ? f.sendSlrp : f.send}
    </button>
    <p class="m-0 text-[0.95rem] text-slate-300" role="status" aria-live="polite" data-status></p>
  </div>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('form[data-contact]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!form.reportValidity()) return;
      const data = new FormData(form);
      if (data.get('_gotcha')) return; // spam
      const endpoint = form.dataset.endpoint;

      if (!endpoint) {
        // Sin servicio de correo configurado: se compone un correo con los datos.
        const lines: string[] = [];
        data.forEach((v, k) => {
          if (!['subject', 'lang', '_gotcha'].includes(k) && String(v).trim()) lines.push(`${k}: ${v}`);
        });
        const href = `mailto:${form.dataset.email}?subject=${encodeURIComponent(String(data.get('subject')))}&body=${encodeURIComponent(lines.join('\n'))}`;
        status.textContent = form.dataset.mailto ?? '';
        window.location.href = href;
        return;
      }

      btn.disabled = true;
      status.textContent = form.dataset.sending ?? '';
      try {
        const res = await fetch(endpoint, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.textContent = form.dataset.sent ?? '';
      } catch {
        status.textContent = form.dataset.error ?? '';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
