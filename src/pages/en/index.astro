---
import Layout from '../../layouts/Layout.astro';

const heroSlides = [
  {
    src: '/images/subestacion-valle-montana.jpg',
    alt: '765 kV bulk power substation and switchyard equipment',
    label: '765 kV Bulk Power Substation',
  },
  {
    src: '/images/benchmarks/eda-substation-night.jpg',
    alt: '500 kV high-voltage substation night view',
    label: '500 kV Bulk Substation',
  },
  {
    src: '/images/sala-control-tableros.jpg',
    alt: 'Control room with protection and control panels',
    label: 'SAS / RTU Control Room',
  },
  {
    src: '/images/benchmarks/pace-hero-equipo.webp',
    alt: 'Field engineers in switchyard in front of power transformer',
    label: 'Field Engineering & FAT/SAT Testing',
  },
  {
    src: '/images/torre-transmision-ciudad.jpg',
    alt: 'Transmission towers and grid interconnection lines',
    label: 'Interconnection & Power Transmission Lines',
  },
];
---

<Layout 
  title="Serviproma Energy | Control, Protection & SCADA in High Voltage" 
  description="High-voltage power systems engineering, electrical protections, SAS automation, and SCADA up to 765 kV for utilities, oil & gas, and heavy industry."
  lang="en" 
  currentPath="/en"
>
  
  <!-- HERO SECTION: INDUSTRIAL IMPACT AND TECHNICAL AUTHORITY -->
  <section class="relative min-h-[92vh] flex flex-col justify-between border-b border-slate-800/80 bg-slate-950 overflow-hidden">
    <!-- BACKGROUND SLIDER (Left-to-Right Rotation) -->
    <div class="absolute inset-0 z-0 pointer-events-none overflow-hidden" id="hero-slider-container">
      <div id="hero-slider-track" class="relative w-full h-full">
        {heroSlides.map((slide, idx) => (
          <div 
            class={`hero-slide absolute inset-0 w-full h-full will-change-transform ${idx === 0 ? 'active' : ''}`}
            data-index={idx}
            data-label={slide.label}
            style={`opacity: ${idx === 0 ? '1' : '0'}; transform: translateX(${idx === 0 ? '0%' : '-100%'}); z-index: ${idx === 0 ? '1' : '0'};`}
          >
            <img 
              src={slide.src} 
              alt={slide.alt} 
              class="w-full h-full object-cover object-[right_bottom]"
              loading={idx === 0 ? "eager" : "lazy"}
            />
          </div>
        ))}
      </div>

      <!-- Continuous dark gradient overlay -->
      <div 
        class="absolute inset-0 z-10"
        style="background: linear-gradient(to right, rgb(2 6 23 / 1) 0%, rgb(2 6 23 / 0.98) 28%, rgb(2 6 23 / 0.88) 42%, rgb(2 6 23 / 0.5) 60%, rgb(2 6 23 / 0.15) 75%, transparent 90%);"
      ></div>
      <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-slate-950 via-slate-950/70 to-transparent z-10"></div>
    </div>

    <!-- Main Hero Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-24 pb-10 relative z-10 w-full my-auto">
      <div class="max-w-2xl lg:max-w-3xl space-y-7">
        
        <div class="inline-flex items-center gap-2.5 px-3 py-1.5 rounded-full border border-amber-500/30 bg-amber-500/10 text-amber-400 text-xs font-semibold tracking-wider uppercase font-mono">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          <span>Power Systems Engineering · 13.8 kV to 765 kV</span>
        </div>

        <h1 class="text-4xl sm:text-6xl lg:text-[4rem] font-extrabold text-white tracking-tight leading-[1.08]">
          Control, protections, and SCADA in high and extra-high voltage
        </h1>

        <p class="text-slate-300 text-base sm:text-lg leading-relaxed font-normal max-w-2xl">
          Backed by specialized senior engineers with over 35 years operating in energized substations and 12 years of direct leadership in National Grid Load Dispatch and Transmission.
        </p>

        <div class="pt-3 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
          <a 
            href="/en/contact" 
            class="px-8 py-4 bg-amber-500 hover:bg-amber-400 text-slate-950 font-bold text-xs uppercase tracking-wider rounded transition-all shadow-lg shadow-amber-500/20 text-center"
          >
            Request Technical Assessment
          </a>
          <a 
            href="#pillars" 
            class="px-8 py-4 border border-slate-700 bg-slate-900/80 hover:bg-slate-800 text-white font-semibold text-xs uppercase tracking-wider rounded transition-all text-center flex items-center justify-center gap-2"
          >
            <span>Explore Operational Pillars</span>
            <span class="text-amber-400 font-bold">↓</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Telemetry Indicators -->
    <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pb-4 hidden sm:flex items-center justify-between text-xs text-slate-400">
      <div class="flex items-center gap-2 font-mono">
        <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
        <span id="slider-caption" class="text-slate-300 text-xs font-semibold tracking-wider uppercase transition-opacity duration-300">
          765 kV Bulk Power Substation
        </span>
      </div>

      <div class="flex items-center gap-3">
        <div class="flex items-center gap-1.5" id="slider-dots">
          {heroSlides.map((slide, idx) => (
            <button 
              type="button" 
              class={`slider-dot h-1.5 rounded-full transition-all duration-500 cursor-pointer ${idx === 0 ? 'w-8 bg-amber-400 shadow-sm shadow-amber-400/50' : 'w-3 bg-slate-700 hover:bg-slate-500'}`}
              data-dot-index={idx}
              title={slide.label}
              aria-label={`View slide: ${slide.label}`}
            ></button>
          ))}
        </div>
        <span class="font-mono text-[11px] text-slate-400 ml-1" id="slider-counter">01 / 05</span>
      </div>
    </div>

    <!-- Metrics Bar -->
    <div class="relative z-10 border-t border-slate-800/80 bg-slate-950/85 backdrop-blur-md">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-6 divide-y sm:divide-y-0 sm:divide-x divide-slate-800/80">
          <div class="pt-2 sm:pt-0 sm:pr-6">
            <div class="text-3xl sm:text-4xl font-bold text-white font-['IBM_Plex_Mono'] tracking-tight">+35</div>
            <div class="text-[11px] sm:text-xs text-slate-400 uppercase tracking-wider mt-0.5 font-mono">Years team experience</div>
          </div>
          <div class="pt-2 sm:pt-0 sm:px-6">
            <div class="text-3xl sm:text-4xl font-bold text-amber-400 font-['IBM_Plex_Mono'] tracking-tight">765 kV</div>
            <div class="text-[11px] sm:text-xs text-slate-400 uppercase tracking-wider mt-0.5 font-mono">Max voltage intervened</div>
          </div>
          <div class="pt-2 sm:pt-0 sm:px-6">
            <div class="text-3xl sm:text-4xl font-bold text-white font-['IBM_Plex_Mono'] tracking-tight">6 Countries</div>
            <div class="text-[11px] sm:text-xs text-slate-400 uppercase tracking-wider mt-0.5 font-mono">Americas & Africa</div>
          </div>
          <div class="pt-2 sm:pt-0 sm:pl-6">
            <div class="text-3xl sm:text-4xl font-bold text-amber-400 font-['IBM_Plex_Mono'] tracking-tight">+20</div>
            <div class="text-[11px] sm:text-xs text-slate-400 uppercase tracking-wider mt-0.5 font-mono">Major industries served</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PILLAR 1: SENIOR HUMAN EXPERTISE -->
  <section id="pillars" class="py-24 border-b border-slate-800/80 bg-slate-950">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-start mb-16">
        <div class="lg:col-span-7 space-y-4">
          <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block font-mono">PILLAR 01 · SENIOR HUMAN EXPERTISE</span>
          <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
            We do not improvise: backed by engineers who operated the most demanding power grids
          </h2>
          <p class="text-slate-300 text-base leading-relaxed">
            In power electrical systems, true value does not lie in a commercial registration date, but in the engineering judgment of field specialists. Our senior team accumulates more than 35 years of combined experience solving grid disturbances and commissioning substations from 13.8 kV to 765 kV.
          </p>
        </div>

        <div class="lg:col-span-5 bg-slate-900 border border-slate-800 rounded-xl overflow-hidden shadow-2xl">
          <div class="h-44 overflow-hidden relative">
            <img 
              src="/images/engineers-field.jpg" 
              alt="Engineering specialists in energized high-voltage switchyard" 
              class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
            <div class="absolute top-3 right-3 px-2.5 py-1 rounded bg-slate-950/80 backdrop-blur-md border border-amber-500/30 text-[10px] font-mono text-amber-400 font-bold uppercase tracking-wider">
              Energized Operations
            </div>
          </div>
          <div class="p-6">
            <div class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3 font-mono">Proven Field Solvency</div>
            <ul class="space-y-3 text-xs text-slate-300">
              <li class="flex items-start gap-2.5">
                <span class="text-amber-400 font-bold">✓</span>
                <span><strong>12 years directly in National Utility:</strong> Load Dispatch and Transmission across Western regions.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-amber-400 font-bold">✓</span>
                <span><strong>Industry & Petrochemicals:</strong> Commissioning and control systems at PEQUIVEN Metanol de Oriente.</span>
              </li>
              <li class="flex items-start gap-2.5">
                <span class="text-amber-400 font-bold">✓</span>
                <span><strong>Global EPC Contractors:</strong> Field experience under Elecnor, Transelec, and Enel standards.</span>
              </li>
            </ul>
          </div>
        </div>
      </div>

      <!-- 4 Technical Blocks -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        <div class="p-6 bg-slate-900/60 border border-slate-800 rounded-xl">
          <div class="text-2xl font-bold text-white font-['IBM_Plex_Mono'] mb-1">765 kV</div>
          <h3 class="text-sm font-bold text-amber-400 mb-2">High & Extra-High Voltage</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Direct intervention in bulk substations at 765, 400, 230, and 115 kV. Mastery of high-voltage transmission dynamics.
          </p>
        </div>

        <div class="p-6 bg-slate-900/60 border border-slate-800 rounded-xl">
          <div class="text-2xl font-bold text-white font-['IBM_Plex_Mono'] mb-1">FAT / SAT</div>
          <h3 class="text-sm font-bold text-amber-400 mb-2">Rigorous Commissioning</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Secondary and primary injection using Omicron precision test sets to calibrate protection schemes and eliminate false trips.
          </p>
        </div>

        <div class="p-6 bg-slate-900/60 border border-slate-800 rounded-xl">
          <div class="text-2xl font-bold text-white font-['IBM_Plex_Mono'] mb-1">IEC 61850</div>
          <h3 class="text-sm font-bold text-amber-400 mb-2">Digital Substations</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Station bus (MMS) engineering, GOOSE messaging, Siemens SICAM RTUs, and secure telecontrol integration to dispatch centers.
          </p>
        </div>

        <div class="p-6 bg-slate-900/60 border border-slate-800 rounded-xl">
          <div class="text-2xl font-bold text-white font-['IBM_Plex_Mono'] mb-1">6 Countries</div>
          <h3 class="text-sm font-bold text-amber-400 mb-2">International Reach</h3>
          <p class="text-xs text-slate-400 leading-relaxed">
            Proven track record in Venezuela, Chile (500 kV and 220 kV), Colombia (230 kV), Mexico, Ivory Coast, and Cameroon.
          </p>
        </div>
      </div>

      <!-- Landmark Projects -->
      <div class="border border-slate-800 bg-slate-900/40 rounded-xl p-6 sm:p-8">
        <div class="text-xs font-bold text-amber-400 uppercase tracking-wider mb-6 font-mono flex items-center justify-between">
          <span>Key Infrastructure Where Our Team Demonstrated Results:</span>
          <span class="hidden sm:inline text-slate-500 text-[11px]">Latin America · 115 kV to 765 kV</span>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <div class="border border-slate-800 bg-slate-950 rounded-lg overflow-hidden flex flex-col group hover:border-slate-700 transition-colors">
            <div class="h-44 overflow-hidden relative">
              <img 
                src="/images/substation-hero.jpg" 
                alt="S/E Cumbres 500 kV in Chile" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-slate-950/80 backdrop-blur-sm border border-slate-700 text-[10px] font-mono text-amber-400 font-semibold">
                500 kV · Chile
              </span>
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <strong class="text-white block text-sm font-bold mb-1">S/E Cumbres (750 MVA ATR)</strong>
                <span class="text-xs text-slate-400 leading-relaxed block">
                  FAT and SAT testing, control system configuration, and protection scheme verification on 750 MVA ATR bank for Elecnor.
                </span>
              </div>
              <div class="pt-3 mt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400 font-mono">
                <span>Client: Elecnor</span>
                <span class="text-amber-400">SAT / SAS</span>
              </div>
            </div>
          </div>

          <div class="border border-slate-800 bg-slate-950 rounded-lg overflow-hidden flex flex-col group hover:border-slate-700 transition-colors">
            <div class="h-44 overflow-hidden relative">
              <img 
                src="/images/refineria-petroleo.jpg" 
                alt="PEQUIVEN Methanol Complex" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-slate-950/80 backdrop-blur-sm border border-slate-700 text-[10px] font-mono text-amber-400 font-semibold">
                Petrochemical · Venezuela
              </span>
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <strong class="text-white block text-sm font-bold mb-1">PEQUIVEN · Metanol de Oriente</strong>
                <span class="text-xs text-slate-400 leading-relaxed block">
                  Configuration, commissioning, and start-up of control systems for substations in Plant 1 and Plant 2.
                </span>
              </div>
              <div class="pt-3 mt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400 font-mono">
                <span>Sector: Gas & Industry</span>
                <span class="text-amber-400">SCADA Control</span>
              </div>
            </div>
          </div>

          <div class="border border-slate-800 bg-slate-950 rounded-lg overflow-hidden flex flex-col group hover:border-slate-700 transition-colors">
            <div class="h-44 overflow-hidden relative">
              <img 
                src="/images/subestacion-porticos.jpg" 
                alt="S/E Kimal and Los Changos 220 kV" 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/30 to-transparent"></div>
              <span class="absolute top-2.5 left-2.5 px-2 py-0.5 rounded bg-slate-950/80 backdrop-blur-sm border border-slate-700 text-[10px] font-mono text-amber-400 font-semibold">
                220 kV · Chile
              </span>
            </div>
            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <strong class="text-white block text-sm font-bold mb-1">S/E Kimal & Los Changos</strong>
                <span class="text-xs text-slate-400 leading-relaxed block">
                  Commissioning and start-up of protection and control systems for line and transformer bays for Transelec.
                </span>
              </div>
              <div class="pt-3 mt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400 font-mono">
                <span>Client: Transelec</span>
                <span class="text-amber-400">220 kV Bays</span>
              </div>
            </div>
          </div>

        </div>
      </div>

    </div>
  </section>

  <!-- PILLAR 2: SPECIALIZED TECHNICAL SOLUTIONS -->
  <section class="py-24 border-b border-slate-800/80 bg-slate-900/40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mb-16">
        <span class="text-xs font-bold text-amber-400 uppercase tracking-widest block font-mono">PILLAR 02 · SPECIALIZED SCOPE</span>
        <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">
          Engineering solutions for bulk power systems
        </h2>
        <p class="mt-3 text-slate-400 text-base">
          We cover the complete project lifecycle: from diagnostics and detailed engineering to factory acceptance testing (FAT) and field energization (SAT).
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        
        <!-- Service 1 -->
        <div class="border border-slate-800 bg-slate-950 rounded-xl overflow-hidden flex flex-col justify-between">
          <div>
            <div class="h-52 overflow-hidden">
              <img 
                src="/images/benchmarks/pace-pruebas-omicron.webp" 
                alt="Secondary injection testing with Omicron set on protection relays" 
                class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6">
              <div class="text-xs text-amber-400 font-semibold uppercase tracking-wider mb-2 font-mono">Multi-Vendor</div>
              <h3 class="text-xl font-bold text-white mb-2">Protection & Commissioning</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">
                Configuration and testing of line (21/87L), transformer (87T), busbar differential (87B), generator, and breaker failure (50BF) relays on Siemens SIPROTEC 4/5, ABB, GE, SEL, and Schneider.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a href="/en/services#protections" class="text-xs font-bold text-amber-400 hover:text-amber-300 inline-flex items-center gap-1 uppercase tracking-wider font-mono">
              View protection scope <span>→</span>
            </a>
          </div>
        </div>

        <!-- Service 2 -->
        <div class="border border-slate-800 bg-slate-950 rounded-xl overflow-hidden flex flex-col justify-between">
          <div>
            <div class="h-52 overflow-hidden">
              <img 
                src="/images/benchmarks/scadatech-sistemas.png" 
                alt="Real-time substation HMI and SCADA supervisory screens" 
                class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6">
              <div class="text-xs text-amber-400 font-semibold uppercase tracking-wider mb-2 font-mono">IEC 61850 & Dispatch</div>
              <h3 class="text-xl font-bold text-white mb-2">Automation & SCADA</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">
                Digital substations, Siemens SICAM RTUs (A8000, AK3, TM1703), gateways, and telecontrol integration to dispatch centers via IEC 60870-5-101/104, DNP3, and ICCP protocols.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a href="/en/services#automation" class="text-xs font-bold text-amber-400 hover:text-amber-300 inline-flex items-center gap-1 uppercase tracking-wider font-mono">
              View SCADA architecture <span>→</span>
            </a>
          </div>
        </div>

        <!-- Service 3 -->
        <div class="border border-slate-800 bg-slate-950 rounded-xl overflow-hidden flex flex-col justify-between">
          <div>
            <div class="h-52 overflow-hidden">
              <img 
                src="/images/refineria-petroleo.jpg" 
                alt="Petrochemical refinery continuous process substation" 
                class="w-full h-full object-cover object-center hover:scale-105 transition-transform duration-500"
              />
            </div>
            <div class="p-6">
              <div class="text-xs text-amber-400 font-semibold uppercase tracking-wider mb-2 font-mono">Petrochemical & Refining</div>
              <h3 class="text-xl font-bold text-white mb-2">Industry & Oil</h3>
              <p class="text-xs text-slate-300 leading-relaxed mb-4">
                Plant substations and MCCs in medium and high voltage. Differential protection for large motors, process generators, and fast load shedding schemes to prevent unplanned outages.
              </p>
            </div>
          </div>
          <div class="p-6 pt-0">
            <a href="/en/services#industry" class="text-xs font-bold text-amber-400 hover:text-amber-300 inline-flex items-center gap-1 uppercase tracking-wider font-mono">
              View industrial plant scope <span>→</span>
            </a>
          </div>
        </div>

      </div>

      <!-- SLRP Technology Solution -->
      <div class="mt-12 border border-slate-800 bg-slate-950 rounded-2xl overflow-hidden grid grid-cols-1 lg:grid-cols-12 shadow-2xl">
        <div class="lg:col-span-7 p-8 sm:p-10 flex flex-col justify-between">
          <div>
            <div class="inline-flex items-center gap-2 text-xs font-bold text-amber-400 uppercase tracking-widest font-mono mb-3">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              <span>Precision Technology</span>
            </div>
            <h3 class="text-2xl sm:text-3xl font-bold text-white mb-3 tracking-tight">
              SLRP: Remote Protection Reading System
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed mb-6">
              Immediate availability of COMTRADE oscillograms (IEEE C37.111) in your dispatch center within 2 minutes after a trip. Rapid forensic diagnosis without road travel or operating blind.
            </p>
            <div class="grid grid-cols-3 gap-3 mb-6">
              <div class="p-3 bg-slate-900 border border-slate-800 rounded text-center">
                <div class="text-amber-400 font-mono font-bold text-lg sm:text-xl">~2 min</div>
                <div class="text-[10px] text-slate-400 uppercase tracking-wider mt-0.5 font-mono">Turnaround</div>
              </div>
              <div class="p-3 bg-slate-900 border border-slate-800 rounded text-center">
                <div class="text-white font-mono font-bold text-lg sm:text-xl">COMTRADE</div>
                <div class="text-[10px] text-slate-400 uppercase tracking-wider mt-0.5 font-mono">IEEE C37.111</div>
              </div>
              <div class="p-3 bg-slate-900 border border-slate-800 rounded text-center">
                <div class="text-amber-400 font-mono font-bold text-lg sm:text-xl">Multi-Brand</div>
                <div class="text-[10px] text-slate-400 uppercase tracking-wider mt-0.5 font-mono">Siemens/SEL/GE</div>
              </div>
            </div>
          </div>
          <div class="pt-2">
            <a 
              href="/en/slrp" 
              class="px-6 py-3.5 border border-amber-500/50 bg-amber-500/10 hover:bg-amber-500 hover:text-slate-950 text-amber-400 font-bold text-xs uppercase tracking-wider rounded transition-all inline-flex items-center gap-2"
