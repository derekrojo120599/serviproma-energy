---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CompareBars from '../components/CompareBars.astro';
import ContactForm from '../components/ContactForm.astro';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const s = c.slrp;
---
<Base lang={lang} page="slrp">
  <PageHeader title={s.title} lead={s.lead} />

  <section class="section">
    <div class="wrap grid gap-14 md:grid-cols-2 md:gap-20">
      <div>
        <h2 class="text-2xl sm:text-3xl">{s.problemTitle}</h2>
        {s.problem.map((p) => <p class="measure mt-5 text-slate-300">{p}</p>)}
      </div>
      <div>
        <h2 class="text-2xl sm:text-3xl">{s.solutionTitle}</h2>
        {s.solution.map((p) => <p class="measure mt-5 text-slate-300">{p}</p>)}
      </div>
    </div>
  </section>

  <section class="section border-y border-slate-800 bg-slate-900">
    <div class="wrap grid items-start gap-14 md:grid-cols-2 md:gap-20">
      <CompareBars without={c.home.slrp.without} with={c.home.slrp.with} />
      <dl class="border-t border-slate-700">
        {s.points.map((p) => (
          <div class="grid grid-cols-[1fr_auto] items-baseline gap-6 border-b border-slate-700 py-5">
            <dt class="text-slate-300">{p.label}</dt>
            <dd class="data m-0 text-right text-xl text-amber-400">{p.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section id="viabilidad" class="section">
    <div class="wrap grid gap-12 lg:grid-cols-[1fr_1.4fr] lg:gap-20">
      <div>
        <h2 class="text-2xl sm:text-3xl">{s.formTitle}</h2>
        <p class="measure mt-5 text-slate-300">{s.formText}</p>
      </div>
      <div class="border border-slate-800 bg-surface p-6 sm:p-9">
        <ContactForm lang={lang} variant="slrp" />
      </div>
    </div>
  </section>
</Base>
