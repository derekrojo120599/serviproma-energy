---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import CtaBand from '../components/CtaBand.astro';
import { paths, type Lang } from '../i18n/routes';
import { t } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang).services;
---
<Base lang={lang} page="services">
  <PageHeader title={s.title} lead={s.lead} />
  <div class="wrap">
    {s.items.map((item) => (
      <section id={item.id} class="grid gap-8 border-b border-slate-800 py-14 md:grid-cols-[1fr_1.5fr] md:gap-16 lg:py-16">
        <h2 class="text-2xl sm:text-3xl">{item.title}</h2>
        <div>
          <p class="measure m-0 text-lg text-slate-200">{item.text}</p>
          <ul class="mt-6 list-disc space-y-2 pl-5 text-slate-300 marker:text-amber-400">
            {item.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </div>
      </section>
    ))}
  </div>
  <div class="mt-16"><CtaBand title={s.ctaTitle} text={s.ctaText} button={s.ctaButton} href={paths.contact[lang]} /></div>
</Base>
