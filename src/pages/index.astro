---
// Corporate Landing Page - Serviproma Energy C.A.
// Color Palette: Navy #0B1B33, Amber #F5B21A, White #FFFFFF, Slate #475569
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>Serviproma Energy C.A. | Control, Protecciones y SCADA en Alta Tensión</title>
    <meta name="description" content="Ingeniería especializada en protecciones eléctricas, automatización SAS (IEC 61850), sistemas SCADA y solución SLRP hasta 765 kV." />
    
    <!-- Tipografía Geométrica Plus Jakarta Sans e IBM Plex Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">
  </head>
  <body class="bg-white text-slate-700 font-['Plus_Jakarta_Sans',sans-serif] antialiased selection:bg-[#F5B21A] selection:text-[#0B1B33]">

    <!-- 1. TOP BAR (Azul marino muy oscuro #0B1B33, texto claro, sellos con icono amarillo) -->
    <header class="bg-[#0B1B33] text-slate-300 text-xs py-2.5 border-b border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row items-center justify-between gap-3">
        
        <!-- Izquierda: 3 sellos de confianza con icono amarillo #F5B21A -->
        <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 sm:gap-6 text-[11px] sm:text-xs">
          <!-- Sello 1 -->
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#F5B21A] shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
            <span class="font-medium text-slate-200">+35 Años de Experiencia</span>
          </div>

          <!-- Sello 2 -->
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#F5B21A] shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd" />
            </svg>
            <span class="font-medium text-slate-200">+20 Grandes Industrias y Subestaciones</span>
          </div>

          <!-- Sello 3 -->
          <div class="flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-[#F5B21A] shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M10 1.944A11.954 11.954 0 012.166 5C2.056 5.649 2 6.319 2 7c0 5.225 3.34 9.67 8 11.317C14.66 16.67 18 12.225 18 7c0-.682-.057-1.35-.166-2.001A11.954 11.954 0 0110 1.944zM11 14a1 1 0 11-2 0 1 1 0 012 0zm0-7a1 1 0 10-2 0v3a1 1 0 102 0V7z" clip-rule="evenodd" />
            </svg>
            <span class="font-medium text-slate-200">100% Continuidad Operativa y Seguridad</span>
          </div>
        </div>

        <!-- Derecha: Teléfono e Iconos de Redes Sociales -->
        <div class="flex items-center gap-5 text-[11px] sm:text-xs">
          <!-- Teléfono con icono amarillo -->
          <a href="tel:+584127251017" class="flex items-center gap-1.5 text-slate-200 hover:text-[#F5B21A] transition-colors font-mono">
            <svg class="w-3.5 h-3.5 text-[#F5B21A]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
            <span>+58 412 725 1017</span>
          </a>

          <!-- Selector de idioma ES / EN -->
          <a href="/en" class="px-1.5 py-0.5 rounded border border-slate-700 bg-slate-900 text-slate-300 hover:text-[#F5B21A] hover:border-[#F5B21A]/50 text-[10px] font-mono font-semibold transition-colors">
            EN
          </a>

          <!-- Redes Sociales -->
          <div class="flex items-center gap-2.5 text-slate-400">
            <!-- LinkedIn -->
            <a href="https://linkedin.com" target="_blank" rel="noopener" class="hover:text-[#F5B21A] transition-colors" aria-label="LinkedIn">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
            </a>
            <!-- WhatsApp -->
            <a href="https://wa.me/584127251017" target="_blank" rel="noopener" class="hover:text-[#F5B21A] transition-colors" aria-label="WhatsApp">
              <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/></svg>
            </a>
            <!-- Email -->
            <a href="mailto:admin@servipromaenergy.com" class="hover:text-[#F5B21A] transition-colors" aria-label="Correo">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </a>
          </div>
        </div>

      </div>
    </header>

    <!-- 2. NAVBAR (Fondo blanco, enlaces centrados con subrayado amarillo el activo, botón amarillo CTA) -->
    <nav class="bg-white border-b border-slate-200/80 sticky top-0 z-40 shadow-xs">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
        
        <!-- Logo a la izquierda -->
        <a href="/" class="flex items-center gap-3 group">
          <img 
            src="/images/logo_azul.png" 
            alt="Serviproma Energy C.A." 
            class="h-10 sm:h-11 w-auto object-contain group-hover:scale-102 transition-transform" 
          />
        </a>

        <!-- Enlaces centrados (Desktop) -->
        <div class="hidden lg:flex items-center gap-7 text-sm font-semibold text-[#0B1B33]">
          <!-- Home (Activo con subrayado amarillo #F5B21A) -->
          <a href="/" class="py-2 text-[#0B1B33] border-b-2 border-[#F5B21A] transition-colors">
            Inicio
          </a>

          <!-- About Us con chevron -->
          <div class="relative group py-2">
            <a href="/nosotros" class="hover:text-[#F5B21A] transition-colors flex items-center gap-1">
              <span>Nosotros</span>
              <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#F5B21A] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </a>
          </div>

          <!-- Services con chevron -->
          <div class="relative group py-2">
            <a href="/servicios" class="hover:text-[#F5B21A] transition-colors flex items-center gap-1">
              <span>Servicios</span>
              <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#F5B21A] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </a>
          </div>

          <!-- Industries con chevron -->
          <div class="relative group py-2">
            <a href="/servicios#industria" class="hover:text-[#F5B21A] transition-colors flex items-center gap-1">
              <span>Industrias</span>
              <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#F5B21A] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </a>
          </div>

          <!-- Projects -->
          <a href="/experiencia" class="hover:text-[#F5B21A] transition-colors py-2">
            Proyectos
          </a>

          <!-- Solución SLRP -->
          <a href="/slrp" class="hover:text-[#F5B21A] transition-colors py-2 flex items-center gap-1.5">
            <span>SLRP</span>
            <span class="px-1.5 py-0.5 text-[9px] font-bold bg-[#F5B21A]/15 text-[#0B1B33] border border-[#F5B21A]/40 rounded font-mono uppercase">
              Exclusivo
            </span>
          </a>

          <!-- Careers -->
          <a href="/nosotros#alcance" class="hover:text-[#F5B21A] transition-colors py-2">
            Carreras
          </a>

          <!-- Contact -->
          <a href="/contacto" class="hover:text-[#F5B21A] transition-colors py-2">
            Contacto
          </a>
        </div>

        <!-- Botón amarillo CTA a la derecha ("Get a Quote" / "Solicitar Cotización") -->
        <div class="flex items-center gap-3">
          <a 
            href="/contacto" 
            class="px-5 py-2.5 bg-[#F5B21A] hover:bg-[#e5a415] text-[#0B1B33] font-bold text-xs uppercase tracking-wider rounded-md transition-all shadow-xs flex items-center gap-2 font-mono"
          >
            <span>Solicitar Cotización</span>
            <span class="font-bold">→</span>
          </a>

          <!-- Botón Menú Móvil -->
          <button id="mobile-toggle" class="lg:hidden p-2 text-[#0B1B33] hover:text-[#F5B21A]" aria-label="Abrir Menú">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
            </svg>
          </button>
        </div>

      </div>

      <!-- Menú Desplegable Móvil -->
      <div id="mobile-drawer" class="hidden lg:hidden border-t border-slate-200 bg-white px-5 py-6 space-y-3 text-sm font-semibold text-[#0B1B33]">
        <a href="/" class="block text-[#0B1B33] font-bold border-l-2 border-[#F5B21A] pl-2">Inicio</a>
        <a href="/nosotros" class="block hover:text-[#F5B21A] py-1 pl-2">Nosotros</a>
        <a href="/servicios" class="block hover:text-[#F5B21A] py-1 pl-2">Servicios</a>
        <a href="/servicios#industria" class="block hover:text-[#F5B21A] py-1 pl-2">Industrias</a>
        <a href="/experiencia" class="block hover:text-[#F5B21A] py-1 pl-2">Proyectos</a>
        <a href="/slrp" class="block hover:text-[#F5B21A] py-1 pl-2">Tecnología SLRP</a>
        <a href="/contacto" class="block hover:text-[#F5B21A] py-1 pl-2">Contacto</a>
      </div>
    </nav>

    <!-- 3. HERO (Foto a ancho completo con degradado blanco desde la izquierda, titular de 2 líneas, 2 botones con flecha) -->
    <section class="relative min-h-[82vh] lg:min-h-[86vh] flex items-center bg-white overflow-hidden border-b border-slate-200">
      
      <!-- Foto de fondo de alta tensión -->
      <div class="absolute inset-0 z-0">
        <img 
          src="/images/subestacion-valle-montana.jpg" 
          alt="Subestación eléctrica de alta tensión y equipos de patio" 
          class="w-full h-full object-cover object-[right_center]"
        />
        <!-- Degradado blanco continuo desde la izquierda para máxima legibilidad -->
        <div 
          class="absolute inset-0"
          style="background: linear-gradient(to right, #FFFFFF 0%, rgba(255,255,255,0.98) 36%, rgba(255,255,255,0.88) 54%, rgba(255,255,255,0.25) 75%, transparent 92%);"
        ></div>
        <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-white via-white/60 to-transparent"></div>
      </div>

      <!-- Contenido del Hero -->
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-28 relative z-10 w-full">
        <div class="max-w-2xl lg:max-w-3xl space-y-6">
          
          <!-- Eyebrow amarillo #F5B21A en mayúsculas pequeñas -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-sm bg-[#F5B21A]/10 border border-[#F5B21A]/30 text-[#0B1B33] text-xs font-mono font-bold tracking-wider uppercase">
            <span class="w-1.5 h-1.5 rounded-full bg-[#F5B21A]"></span>
            <span>INGENIERÍA EN SISTEMAS DE POTENCIA · 13.8 kV A 765 kV</span>
          </div>

          <!-- Titular grande en dos líneas: 1ª azul marino #0B1B33, 2ª amarillo #F5B21A -->
          <h1 class="text-4xl sm:text-6xl lg:text-[4.2rem] font-extrabold tracking-tight leading-[1.08]">
            <span class="block text-[#0B1B33]">Control, protecciones y SCADA</span>
            <span class="block text-[#F5B21A]">en alta y extra alta tensión</span>
          </h1>

          <!-- Subtítulo de 2 líneas en gris/azul marino -->
          <p class="text-slate-600 text-base sm:text-lg leading-relaxed font-normal max-w-2xl">
            El respaldo de ingenieros especialistas con más de 35 años operando en subestaciones energizadas y 12 años de liderazgo directo en el Despacho de Carga y Transmisión nacional.
          </p>

          <!-- Dos botones con flecha: primario amarillo #F5B21A y secundario azul marino #0B1B33 -->
          <div class="pt-4 flex flex-col sm:flex-row items-stretch sm:items-center gap-4">
            <a 
              href="/contacto" 
              class="px-8 py-4 bg-[#F5B21A] hover:bg-[#e5a415] text-[#0B1B33] font-mono font-bold text-xs uppercase tracking-wider rounded-md transition-all shadow-sm flex items-center justify-center gap-2 group"
            >
              <span>Solicitar Evaluación Técnica</span>
              <span class="group-hover:translate-x-1 transition-transform">→</span>
            </a>

            <a 
              href="/servicios" 
              class="px-8 py-4 bg-[#0B1B33] hover:bg-[#132847] text-white font-mono font-semibold text-xs uppercase tracking-wider rounded-md transition-all shadow-sm flex items-center justify-center gap-2 group"
            >
              <span>Explorar Servicios</span>
              <span class="text-[#F5B21A] group-hover:translate-x-1 transition-transform">→</span>
            </a>
          </div>

        </div>
      </div>
    </section>

    <!-- 4. FRANJA DE SERVICIOS SUPERPUESTA AL BORDE INFERIOR DEL HERO -->
    <!-- Barra azul marino #0B1B33 flotante con 4 columnas separadas por líneas finas -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-14 sm:-mt-16 lg:-mt-20 relative z-20">
      <div class="bg-[#0B1B33] rounded-md shadow-2xl border border-slate-800 text-white p-6 lg:p-8">
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-0 divide-y md:divide-y-0 lg:divide-x divide-slate-800">
          
          <!-- Columna 1 -->
          <div class="pt-4 md:pt-0 lg:px-6 first:pl-0">
            <div class="w-10 h-10 rounded-sm bg-[#F5B21A]/10 text-[#F5B21A] flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
            </div>
            <h3 class="text-base font-bold text-white mb-2 tracking-tight">Protecciones y Comisionamiento</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Ajuste y parametrización de relés 21/87L/87T, pruebas FAT y SAT con maletas de precisión Omicron.
            </p>
          </div>

          <!-- Columna 2 -->
          <div class="pt-4 md:pt-0 lg:px-6">
            <div class="w-10 h-10 rounded-sm bg-[#F5B21A]/10 text-[#F5B21A] flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/></svg>
            </div>
            <h3 class="text-base font-bold text-white mb-2 tracking-tight">Automatización y SCADA</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Subestaciones digitales IEC 61850, RTUs Siemens SICAM, telecontrol DNP3/ICCP hacia despachos.
            </p>
          </div>

          <!-- Columna 3 -->
          <div class="pt-4 md:pt-0 lg:px-6">
            <div class="w-10 h-10 rounded-sm bg-[#F5B21A]/10 text-[#F5B21A] flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <h3 class="text-base font-bold text-white mb-2 tracking-tight">Solución Tecnológica SLRP</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Extracción remota automatizada de oscilografías COMTRADE (IEEE C37.111) en ~2 minutos post-falla.
            </p>
          </div>

          <!-- Columna 4 -->
          <div class="pt-4 md:pt-0 lg:px-6 last:pr-0">
            <div class="w-10 h-10 rounded-sm bg-[#F5B21A]/10 text-[#F5B21A] flex items-center justify-center mb-4">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>
            </div>
            <h3 class="text-base font-bold text-white mb-2 tracking-tight">Estudios de Potencia</h3>
            <p class="text-xs text-slate-300 leading-relaxed">
              Coordinación de protecciones, cálculo de cortocircuito, flujo de carga y esquemas de bote de carga.
            </p>
          </div>

        </div>

      </div>
    </div>

    <!-- 5. SECCIÓN DE PROYECTOS (Fondo blanco, Eyebrow amarillo + titular a la izquierda, botón outline a la derecha, grid de 4 tarjetas) -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Encabezado de Sección -->
        <div class="flex flex-col md:flex-row md:items-end justify-between mb-14 gap-6">
          <div>
            <span class="text-xs font-bold text-[#F5B21A] uppercase tracking-widest block font-mono mb-2">PROYECTOS Y EXPERIENCIA DE CAMPO</span>
            <h2 class="text-3xl sm:text-4xl font-extrabold text-[#0B1B33] tracking-tight">
              Infraestructura Crítica de Alta Tensión<br class="hidden sm:inline" /> Ejecutada en la Región
            </h2>
          </div>

          <a 
            href="/experiencia" 
            class="inline-flex items-center gap-2 px-6 py-3 border-2 border-[#0B1B33] text-[#0B1B33] hover:bg-[#0B1B33] hover:text-white rounded-md font-mono font-bold text-xs uppercase tracking-wider transition-all self-start md:self-end"
          >
            <span>Ver Todos los Proyectos</span>
            <span>→</span>
          </a>
        </div>

        <!-- Grid de 4 tarjetas (desktop 4 cols, tablet 2, móvil 1) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Tarjeta 1 -->
          <div class="bg-white border border-slate-200 rounded-md overflow-hidden shadow-xs hover:shadow-md transition-shadow flex flex-col group">
            <div class="h-48 overflow-hidden relative">
              <img 
                src="/images/substation-hero.jpg" 
                alt="S/E Cumbres 500 kV Elecnor" 
