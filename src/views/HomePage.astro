---
import Base from '../layouts/Base.astro';
import Oscillogram from '../components/Oscillogram.astro';
import CompareBars from '../components/CompareBars.astro';
import CtaBand from '../components/CtaBand.astro';
import { paths, type Lang } from '../i18n/routes';
import { t } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = t(lang);
const h = c.home;
---
<Base lang={lang} page="home">
  <!-- Portada -->
  <section class="border-b border-slate-800">
    <div class="wrap grid items-center gap-14 py-14 lg:grid-cols-[1fr_1.05fr] lg:py-24">
      <div>
        <h1 class="text-4xl font-bold sm:text-5xl lg:text-[3.35rem]">{h.hero.title}</h1>
        <p class="measure mt-7 text-xl text-slate-300">{h.hero.lead}</p>
        <div class="mt-10 flex flex-wrap gap-4">
          <a href={paths.contact[lang]} class="btn-primary">{h.hero.primary}</a>
          <a href={paths.slrp[lang]} class="btn-secondary">{h.hero.secondary}</a>
        </div>
      </div>
      <div class="border border-slate-800 bg-surface p-5 sm:p-7">
        <Oscillogram label={h.hero.chartLabel} note={h.hero.chartNote} fault={h.hero.chartFault} trip={h.hero.chartTrip} />
      </div>
    </div>
  </section>

  <!-- Pilar 1: experiencia del personal senior -->
  <section class="section">
    <div class="wrap grid gap-14 md:grid-cols-[1fr_1.1fr]">
      <div>
        <h2 class="text-3xl sm:text-4xl">{h.experience.title}</h2>
        <p class="measure mt-6 text-slate-300">{h.experience.text}</p>
        <a href={paths.about[lang]} class="mt-8 inline-block border-b-2 border-amber-400 pb-1 font-semibold text-white hover:text-amber-400">{h.experience.link}</a>
      </div>
      <dl class="border-t border-slate-800">
        {h.experience.facts.map((f) => (
          <div class="grid items-baseline gap-1 border-b border-slate-800 py-5 sm:grid-cols-[1fr_auto] sm:gap-6">
            <dt class="text-slate-300">{f.label}</dt>
            <dd class="data m-0 text-3xl text-amber-400">{f.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Pilar 2: servicios técnicos -->
  <section class="section border-t border-slate-800">
    <div class="wrap">
      <div class="max-w-3xl">
        <h2 class="text-3xl sm:text-4xl">{h.services.title}</h2>
        <p class="mt-6 text-slate-300">{h.services.text}</p>
      </div>
      <ul class="mt-12 border-t border-slate-800">
        {h.services.items.map((s) => (
          <li class="grid gap-3 border-b border-slate-800 py-7 md:grid-cols-[1fr_1.4fr_15rem] md:items-baseline md:gap-10">
            <h3 class="text-xl">{s.title}</h3>
            <p class="m-0 text-slate-300">{s.text}</p>
            <ul class="flex flex-wrap gap-2 md:justify-end">
              {s.tags.map((tag) => <li class="data border border-slate-700 px-2.5 py-1 text-sm text-slate-300">{tag}</li>)}
            </ul>
          </li>
        ))}
      </ul>
      <a href={paths.services[lang]} class="mt-8 inline-block border-b-2 border-amber-400 pb-1 font-semibold text-white hover:text-amber-400">{h.services.link}</a>
    </div>
  </section>

  <!-- SLRP -->
  <section class="section border-y border-slate-800 bg-slate-900">
    <div class="wrap grid items-center gap-14 md:grid-cols-2">
      <div>
        <h2 class="text-3xl sm:text-4xl">{h.slrp.title}</h2>
        <p class="measure mt-6 text-slate-300">{h.slrp.text}</p>
        <a href={paths.slrp[lang]} class="btn-primary mt-9">{h.slrp.cta}</a>
      </div>
      <CompareBars without={h.slrp.without} with={h.slrp.with} />
    </div>
  </section>

  <!-- Pilar 3: cierre y diferenciadores -->
  <section class="section">
    <div class="wrap">
      <h2 class="text-3xl sm:text-4xl">{h.close.title}</h2>
      <div class="mt-12 grid gap-10 md:grid-cols-3 md:gap-0">
        {h.close.points.map((p) => (
          <div class="border-t border-slate-700 pt-6 md:border-l md:border-t-0 md:px-8 md:pt-0 md:first:border-l-0 md:first:pl-0">
            <h3 class="text-xl">{p.title}</h3>
            <p class="mt-4 text-slate-300">{p.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title={h.close.ctaTitle} text={h.close.ctaText} button={h.close.ctaButton} href={paths.contact[lang]} />
</Base>
