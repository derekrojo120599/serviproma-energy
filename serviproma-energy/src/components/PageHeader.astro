---
interface Props { title: string; lead: string }
const { title, lead } = Astro.props;
---
<section class="border-b border-slate-800">
  <div class="wrap py-16 lg:py-24">
    <h1 class="max-w-4xl text-4xl font-bold sm:text-5xl">{title}</h1>
    <p class="measure mt-6 text-xl text-slate-300">{lead}</p>
  </div>
</section>
